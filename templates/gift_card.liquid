<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ gift_card.initial_value | money_without_trailing_zeros }} Gift Card — {{ shop.name }}</title>
  {{ content_for_header }}
  {{ 'elara-ivy.css' | asset_url | stylesheet_tag }}
  <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
  <style>
    .gc-page {
      font-family: 'Jost', sans-serif;
      color: #0D1B3E;
    }

    .gc-hero {
      background-color: #0D1B3E;
      padding: 64px 48px 56px;
      text-align: center;
    }

    .gc-hero__eyebrow {
      font-size: 11px;
      letter-spacing: 0.3em;
      text-transform: uppercase;
      color: #CFAE70;
      margin-bottom: 12px;
    }

    .gc-hero__value {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: clamp(48px, 8vw, 80px);
      font-weight: 300;
      font-style: italic;
      color: #ffffff;
      line-height: 1;
      margin-bottom: 12px;
    }

    .gc-hero__sub {
      font-size: 14px;
      font-weight: 300;
      color: rgba(255,255,255,0.5);
      letter-spacing: 0.1em;
    }

    .gc-body {
      max-width: 600px;
      margin: 0 auto;
      padding: 56px 24px;
    }

    .gc-card {
      background: #0D1B3E;
      border-radius: 4px;
      padding: 48px 40px;
      margin-bottom: 40px;
      position: relative;
      overflow: hidden;
      text-align: center;
    }

    .gc-card__circle-1 {
      position: absolute;
      top: -50px;
      right: -50px;
      width: 220px;
      height: 220px;
      border-radius: 50%;
      background: #6E73B8;
      opacity: 0.12;
    }

    .gc-card__circle-2 {
      position: absolute;
      bottom: -60px;
      left: -40px;
      width: 200px;
      height: 200px;
      border-radius: 50%;
      background: #F3C7D3;
      opacity: 0.08;
    }

    .gc-card__logo {
      font-family: 'Jost', sans-serif;
      font-size: 13px;
      letter-spacing: 0.3em;
      color: rgba(255,255,255,0.5);
      margin-bottom: 20px;
      position: relative;
      z-index: 1;
    }

    .gc-card__amount {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: 52px;
      font-style: italic;
      font-weight: 300;
      color: #ffffff;
      margin-bottom: 24px;
      position: relative;
      z-index: 1;
    }

    .gc-card__code {
      font-size: 14px;
      letter-spacing: 0.2em;
      color: #CFAE70;
      background: rgba(255,255,255,0.07);
      padding: 12px 24px;
      border-radius: 2px;
      display: inline-block;
      position: relative;
      z-index: 1;
    }

    .gc-card__disabled {
      font-size: 10px;
      letter-spacing: 0.2em;
      color: #F3C7D3;
      margin-top: 12px;
      text-transform: uppercase;
      position: relative;
      z-index: 1;
    }

    .gc-balance {
      background: #F5F3F0;
      border-left: 3px solid #6E73B8;
      padding: 20px 24px;
      margin-bottom: 36px;
      border-radius: 0 2px 2px 0;
    }

    .gc-balance__label {
      font-size: 10px;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: #999;
      margin-bottom: 6px;
    }

    .gc-balance__amount {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: 32px;
      font-style: italic;
      color: #0D1B3E;
    }

    .gc-qr {
      text-align: center;
      margin-bottom: 36px;
    }

    .gc-qr__wrap {
      display: inline-block;
      padding: 16px;
      background: #ffffff;
      border: 1px solid #E8E4DF;
      border-radius: 4px;
    }

    .gc-qr__label {
      font-size: 10px;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: #999;
      margin-top: 12px;
    }

    .gc-actions {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 12px;
      margin-bottom: 36px;
    }

    .gc-btn-copy {
      font-family: 'Jost', sans-serif;
      font-size: 11px;
      font-weight: 400;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: #ffffff;
      background: #0D1B3E;
      border: none;
      padding: 14px 40px;
      border-radius: 2px;
      cursor: pointer;
      width: 100%;
      max-width: 300px;
      transition: background 0.2s ease;
    }

    .gc-btn-copy:hover {
      background: #6E73B8;
    }

    .gc-copy-confirm {
      font-size: 12px;
      color: #6E73B8;
      letter-spacing: 0.1em;
      height: 18px;
      text-align: center;
    }

    .gc-print {
      font-size: 11px;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: #999;
      text-decoration: none;
      border-bottom: 1px solid #D8D4CE;
      padding-bottom: 2px;
      transition: color 0.2s;
    }

    .gc-print:hover {
      color: #0D1B3E;
    }

    .gc-footer-note {
      margin-top: 40px;
      padding-top: 32px;
      border-top: 1px solid #EDE9E4;
      text-align: center;
    }

    .gc-footer-note p {
      font-size: 13px;
      font-weight: 300;
      color: #888;
      line-height: 1.85;
      margin-bottom: 24px;
    }

    .gc-btn-shop {
      display: inline-block;
      font-family: 'Jost', sans-serif;
      font-size: 11px;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: #0D1B3E;
      background: #CFAE70;
      padding: 14px 36px;
      border-radius: 2px;
      text-decoration: none;
      transition: opacity 0.2s;
    }

    .gc-btn-shop:hover {
      opacity: 0.85;
    }

    @media print {
      .site-header,
      .gc-actions,
      .gc-print,
      .gc-footer-note .gc-btn-shop,
      .site-footer { display: none; }
      .gc-body { padding: 20px; }
    }

    @media (max-width: 480px) {
      .gc-hero { padding: 48px 24px 40px; }
      .gc-card { padding: 36px 24px; }
    }
  </style>
</head>
<body>

  {% if settings.announcement_bar_enabled %}
    <div class="announcement-bar">{{ settings.announcement_bar_text }}</div>
  {% endif %}

  <header class="site-header">
    <a href="{{ routes.root_url }}" class="site-header__logo">ELARA IVY CO.</a>
    <nav class="site-header__nav">
      <a href="{{ routes.collections_url }}">NEW IN</a>
      <a href="/pages/designers">DESIGNERS</a>
      <a href="/collections/clothing">CLOTHING</a>
      <a href="/collections/accessories">ACCESSORIES</a>
      <a href="/blogs/journal">EDITORIAL</a>
    </nav>
    <div class="site-header__icons">
      <a href="{{ routes.search_url }}"><svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg></a>
      <a href="{{ routes.account_url }}"><svg viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg></a>
      <a href="{{ routes.cart_url }}"><svg viewBox="0 0 24 24"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg></a>
    </div>
  </header>

  <div class="gc-page">

    <div class="gc-hero">
      <p class="gc-hero__eyebrow">Gift Card</p>
      <div class="gc-hero__value">{{ gift_card.initial_value | money_without_trailing_zeros }}</div>
      <p class="gc-hero__sub">Elara Ivy Co. — curated luxury, delivered.</p>
    </div>

    <div class="gc-body">

      <div class="gc-card">
        <div class="gc-card__circle-1"></div>
        <div class="gc-card__circle-2"></div>
        <div class="gc-card__logo">ELARA IVY CO.</div>
        <div class="gc-card__amount">{{ gift_card.initial_value | money_without_trailing_zeros }}</div>
        <div class="gc-card__code" id="gift-card-code">{{ gift_card.code | format_code }}</div>
        {% unless gift_card.enabled %}
          <div class="gc-card__disabled">This gift card has been disabled</div>
        {% endunless %}
      </div>

      {% if gift_card.balance != gift_card.initial_value %}
        <div class="gc-balance">
          <div class="gc-balance__label">Remaining balance</div>
          <div class="gc-balance__amount">{{ gift_card.balance | money }}</div>
        </div>
      {% endif %}

      <div class="gc-qr">
        <div class="gc-qr__wrap">
          <div id="qr-code"></div>
        </div>
        <div class="gc-qr__label">Scan to redeem</div>
      </div>

      <div class="gc-actions">
        <button class="gc-btn-copy" onclick="copyCode()">Copy gift card code</button>
        <div class="gc-copy-confirm" id="copy-confirm"></div>
        <a href="#" onclick="window.print();return false;" class="gc-print">Print gift card</a>
      </div>

      <div class="gc-footer-note">
        <p>
          This gift card can be used at checkout on <strong>elara-ivy-co.myshopify.com</strong>.<br>
          Gift cards do not expire and cannot be exchanged for cash.
        </p>
        <a href="{{ routes.root_url }}" class="gc-btn-shop">Shop the edit</a>
      </div>

    </div>
  </div>

  <footer class="site-footer">
    <div class="site-footer__inner">
      <div>
        <div class="site-footer__logo">ELARA IVY CO.</div>
        <div class="site-footer__tagline">A curated edit of the world's most considered designers. Fashion with intention.</div>
      </div>
      <div class="site-footer__cols">
        <div class="site-footer__col">
          <div class="site-footer__col-title">SHOP</div>
          <a href="{{ routes.collections_url }}">New In</a>
          <a href="/pages/designers">Designers</a>
          <a href="/collections/clothing">Clothing</a>
          <a href="/collections/accessories">Accessories</a>
        </div>
        <div class="site-footer__col">
          <div class="site-footer__col-title">JOURNAL</div>
          <a href="/blogs/journal">The Edit</a>
          <a href="/blogs/lookbooks">Lookbooks</a>
          <a href="/blogs/style-notes">Style Notes</a>
        </div>
        <div class="site-footer__col">
          <div class="site-footer__col-title">HELP</div>
          <a href="/policies/shipping-policy">Shipping & Returns</a>
          <a href="/pages/size-guide">Size Guide</a>
          <a href="/pages/contact">Contact</a>
        </div>
      </div>
    </div>
    <div class="site-footer__rule"></div>
    <div class="site-footer__bottom">
      <div class="site-footer__copy">© {{ 'now' | date: '%Y' }} ELARA IVY CO. ALL RIGHTS RESERVED.</div>
      <div class="site-footer__copy">INSTAGRAM · PINTEREST · TIKTOK</div>
    </div>
  </footer>

  {{ 'elara-ivy.js' | asset_url | script_tag }}

  <script>
    new QRCode(document.getElementById('qr-code'), {
      text: '{{ gift_card.code }}',
      width: 130,
      height: 130,
      colorDark: '#0D1B3E',
      colorLight: '#ffffff',
      correctLevel: QRCode.CorrectLevel.H
    });

    function copyCode() {
      var code = '{{ gift_card.code | format_code }}';
      navigator.clipboard.writeText(code).then(function() {
        var el = document.getElementById('copy-confirm');
        el.textContent = 'Code copied!';
        setTimeout(function() { el.textContent = ''; }, 3000);
      });
    }
  </script>

</body>
</html>
