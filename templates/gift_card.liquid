<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ gift_card.initial_value | money_without_trailing_zeros }} Gift Card — {{ shop.name }}</title>
  {{ content_for_header }}
  {{ 'elara-ivy.css' | asset_url | stylesheet_tag }}
</head>
<body>

  <header class="site-header">
    <a href="{{ routes.root_url }}" class="site-header__logo">ELARA IVY CO.</a>
  </header>

  <div class="section section--white" style="text-align:center;padding:80px 24px;">
    <div style="max-width:560px;margin:0 auto;">

      <div style="font-size:9px;letter-spacing:0.3em;color:var(--periwinkle);margin-bottom:16px;">GIFT CARD</div>
      <h1 class="ei-serif" style="font-size:42px;font-style:italic;font-weight:300;color:var(--navy);margin-bottom:8px;">
        {{ gift_card.initial_value | money_without_trailing_zeros }}
      </h1>
      <p style="font-size:13px;color:var(--ink-muted);margin-bottom:40px;">Elara Ivy Co. Gift Card</p>

      <!-- Gift Card Visual -->
      <div style="background:var(--navy);padding:48px 40px;margin-bottom:40px;position:relative;overflow:hidden;">
        <div style="position:absolute;top:-40px;right:-40px;width:200px;height:200px;border-radius:50%;background:var(--periwinkle);opacity:0.15;"></div>
        <div style="position:absolute;bottom:-60px;left:-30px;width:180px;height:180px;border-radius:50%;background:var(--blush);opacity:0.1;"></div>
        <div class="ei-serif" style="font-size:18px;letter-spacing:0.24em;color:#BCC4DE;margin-bottom:24px;">ELARA IVY CO.</div>
        <div style="font-size:32px;font-family:'Cormorant Garamond',serif;font-style:italic;color:#fff;font-weight:300;margin-bottom:24px;">
          {{ gift_card.initial_value | money_without_trailing_zeros }}
        </div>
        <div id="gift-card-code" style="font-size:13px;letter-spacing:0.18em;color:var(--periwinkle);background:rgba(255,255,255,0.06);padding:12px 20px;display:inline-block;margin-bottom:8px;">
          {{ gift_card.code | format_code }}
        </div>
        {% unless gift_card.enabled %}
          <div style="font-size:10px;letter-spacing:0.16em;color:var(--blush);margin-top:12px;">DISABLED</div>
        {% endunless %}
      </div>

      <!-- Balance -->
      {% if gift_card.balance != gift_card.initial_value %}
        <div style="background:var(--surface-warm);padding:20px;margin-bottom:32px;border-left:3px solid var(--periwinkle);">
          <div style="font-size:9px;letter-spacing:0.2em;color:var(--ink-muted);margin-bottom:6px;">REMAINING BALANCE</div>
          <div class="ei-serif" style="font-size:28px;color:var(--navy);">{{ gift_card.balance | money }}</div>
        </div>
      {% endif %}

      <!-- QR Code -->
      <div style="margin-bottom:32px;">
        <img
          src="{{ gift_card.qr_identifier | image_url: width: 120 }}"
          alt="QR code"
          width="120"
          height="120"
          style="margin:0 auto;display:block;">
      </div>

      <!-- Copy Code Button -->
      <button onclick="copyCode()" class="btn-primary" style="margin-bottom:16px;width:100%;max-width:280px;">
        COPY GIFT CARD CODE
      </button>

      <div id="copy-confirm" style="font-size:11px;color:var(--periwinkle);letter-spacing:0.1em;height:20px;margin-bottom:24px;"></div>

      <!-- Print -->
      <div>
        <a href="#" onclick="window.print();return false;" style="font-size:10px;letter-spacing:0.16em;color:var(--ink-muted);border-bottom:1px solid var(--rule);">PRINT GIFT CARD</a>
      </div>

      <div style="margin-top:40px;padding-top:32px;border-top:1px solid var(--rule);">
        <p style="font-size:12px;color:var(--ink-muted);line-height:1.8;margin-bottom:20px;">
          This gift card can be used at checkout on elara-ivy-co.myshopify.com.<br>
          Gift cards do not expire and cannot be exchanged for cash.
        </p>
        <a href="{{ routes.root_url }}" class="btn-secondary">SHOP THE EDIT</a>
      </div>

    </div>
  </div>

  <footer class="site-footer">
    <div style="text-align:center;padding:20px;">
      <div class="site-footer__copy">© {{ 'now' | date: '%Y' }} ELARA IVY CO. ALL RIGHTS RESERVED.</div>
    </div>
  </footer>

  <script>
    function copyCode() {
      var code = '{{ gift_card.code | format_code }}';
      navigator.clipboard.writeText(code).then(function() {
        var confirm = document.getElementById('copy-confirm');
        confirm.textContent = 'CODE COPIED!';
        setTimeout(function() { confirm.textContent = ''; }, 3000);
      });
    }
  </script>

</body>
</html>
