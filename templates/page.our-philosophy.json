          "settings": {
            "title": "Does it earn its place in a wardrobe?",
            "body": "A beautiful piece is not enough. We ask whether every item we carry genuinely belongs in a life — not just a lookbook. If we can't imagine it being reached for again and again, worn differently across seasons, it doesn't make the edit."
          }
        },
        "pillar_zwyYJt": {
          "type": "pillar",
          "settings": {
            "title": "Would we be proud to recommend this to someone we know?",
            "body": "Every piece we carry passes a simple test: would we send this to a friend, hand on heart, knowing it would be worth every penny? If there's any hesitation, the answer is no. Our edit is built on the kind of trust that outlasts a transaction."
          }
        },
        "pillar_cNmdX9": {
          "type": "pillar",
          "settings": {
            "title": "Does it serve her, or just impress her?",
            "body": "There's a difference between a piece that commands a room and one that quietly changes how you carry yourself. We look for both — but when a piece only does one, we choose the latter. Elara Ivy is for women who dress for themselves first."
          }
        },
        "dont_item_8a3AVk": {
          "type": "dont_item",
          "settings": {
            "title": "Inflated prices or artificial markups",
            "body": "We carry designer pieces at market price or below — never marked up to manufacture a discount. What you see is what the piece is worth."
          }
        },
        "dont_item_bYcnBg": {
          "type": "dont_item",
          "settings": {
            "title": "Flash sales and manufactured urgency",
            "body": "No countdown timers, no \"only 2 left\" pressure tactics. If a piece sells out, it sells out. We'd rather you buy with confidence than rush."
          }
        },
        "dont_item_wGCXKG": {
          "type": "dont_item",
          "settings": {
            "title": "Trend-chasing for its own sake",
            "body": "We don't add designers because they're having a moment. We add them because we believe in what they stand for — and we're prepared to carry them beyond the moment."
          }
        },
        "dont_item_ttKYp9": {
          "type": "dont_item",
          "settings": {
            "title": "Brands that don't earn their place",
            "body": "Every designer in our edit has been reviewed against the same three questions we ask of every piece. There are no legacy inclusions, no paid placements. If they're here, they belong here."
          }
