<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="{{ page_description | escape }}">
  <title>{{ page_title }} — {{ shop.name }}</title>
  {{ content_for_header }}
  {{ 'elara-ivy.css' | asset_url | stylesheet_tag }}
</head>
<body>
  <div class="mobile-nav" id="mobile-nav">
    <button class="mobile-nav__close" onclick="document.getElementById('mobile-nav').classList.remove('is-open')">
      <svg viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
    <a href="{{ routes.root_url }}">Home</a>
    <a href="{{ routes.collections_url }}">New In</a>
    <a href="/pages/designers">Designers</a>
    <a href="/collections/clothing">Clothing</a>
    <a href="/collections/accessories">Accessories</a>
    <a href="/blogs/journal">Editorial</a>
  </div>
  {% if settings.announcement_bar_enabled %}
    <div class="announcement-bar">{{ settings.announcement_bar_text }}</div>
  {% endif %}
  <header class="site-header">
    <a href="{{ routes.root_url }}" class="site-header__logo">ELARA IVY CO.</a>
    <nav class="site-header__nav">
      <a href="{{ routes.collections_url }}">NEW IN</a>
      <a href="/pages/designers">DESIGNERS</a>
      <a href="/collections/clothing">CLOTHING</a>
      <a href="/collections/accessories">ACCESSORIES</a>
      <a href="/blogs/journal">EDITORIAL</a>
    </nav>
    <div class="site-header__icons">
      <a href="{{ routes.search_url }}"><svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg></a>
      <a href="{{ routes.account_url }}"><svg viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg></a>
      <a href="{{ routes.cart_url }}"><svg viewBox="0 0 24 24"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg></a>
      <div class="site-header__hamburger" onclick="document.getElementById('mobile-nav').classList.add('is-open')">
        <span></span><span></span><span></span>
      </div>
    </div>
  </header>
  <main id="main-content">{{ content_for_layout }}</main>
  <footer class="site-footer">
    <div class="site-footer__inner">
      <div>
        <div class="site-footer__logo">ELARA IVY CO.</div>
        <div class="site-footer__tagline">A curated edit of the world's most considered designers. Fashion with intention.</div>
      </div>
      <div class="site-footer__cols">
        <div class="site-footer__col">
          <div class="site-footer__col-title">SHOP</div>
          <a href="{{ routes.collections_url }}">New In</a>
          <a href="/pages/designers">Designers</a>
          <a href="/collections/clothing">Clothing</a>
          <a href="/collections/accessories">Accessories</a>
        </div>
        <div class="site-footer__col">
          <div class="site-footer__col-title">JOURNAL</div>
          <a href="/blogs/journal">The Edit</a>
          <a href="/blogs/lookbooks">Lookbooks</a>
          <a href="/blogs/style-notes">Style Notes</a>
        </div>
        <div class="site-footer__col">
          <div class="site-footer__col-title">HELP</div>
          <a href="/policies/shipping-policy">Shipping & Returns</a>
          <a href="/pages/size-guide">Size Guide</a>
          <a href="/pages/contact">Contact</a>
        </div>
      </div>
    </div>
    <div class="site-footer__rule"></div>
    <div class="site-footer__bottom">
      <div class="site-footer__copy">© {{ 'now' | date: '%Y' }} ELARA IVY CO. ALL RIGHTS RESERVED.</div>
      <div class="site-footer__copy">INSTAGRAM · PINTEREST · TIKTOK</div>
    </div>
  </footer>
  {{ 'elara-ivy.js' | asset_url | script_tag }}
</body>
</html>
