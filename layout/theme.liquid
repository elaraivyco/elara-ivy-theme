<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="{{ page_description | escape }}">
  <title>{{ page_title }} — {{ shop.name }}</title>
  {{ content_for_header }}
  {{ 'elara-ivy.css' | asset_url | stylesheet_tag }}
</head>
<body>
  <div class="mobile-nav" id="mobile-nav">
    <button class="mobile-nav__close" onclick="document.getElementById('mobile-nav').classList.remove('is-open')">
      <svg viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
    <a href="{{ routes.root_url }}">Home</a>
    <a href="/pages/new-in">New In</a>
    <a href="/pages/designers">Designers</a>
    <a href="/pages/clothing">Clothing</a>
    <a href="/collections/handbags">Handbags</a>
    <a href="/pages/accessories">Accessories</a>
  </div>
  {% if settings.announcement_bar_enabled %}
    <div class="announcement-bar">{{ settings.announcement_bar_text }}</div>
  {% endif %}
  <header class="site-header">
    <a href="{{ routes.root_url }}" class="site-header__logo">ELARA IVY CO.</a>
    <nav class="site-header__nav">
      <a href="/pages/new-in">NEW IN</a>
      <a href="/pages/designers">DESIGNERS</a>
      <a href="/pages/clothing">CLOTHING</a>
      <a href="/collections/handbags">HANDBAGS</a>
      <a href="/pages/accessories">ACCESSORIES</a>
    </nav>
    <div class="site-header__icons">
      <a href="{{ routes.search_url }}"><svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg></a>
      <a href="{{ routes.account_url }}"><svg viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg></a>
      <a href="{{ routes.cart_url }}"><svg viewBox="0 0 24 24"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg></a>
      <div class="site-header__hamburger" onclick="document.getElementById('mobile-nav').classList.add('is-open')">
        <span></span><span></span><span></span>
      </div>
    </div>
  </header>
  <main id="main-content">{{ content_for_layout }}</main>
  <footer class="site-footer">
    <div class="site-footer__inner">
      <div>
        <div class="site-footer__logo">ELARA IVY CO.</div>
        <div class="site-footer__tagline">A curated edit of the world's most considered designers. Fashion with intention.</div>
      </div>
      <div class="site-footer__cols">
        <div class="site-footer__col">
          <div class="site-footer__col-title">SHOP</div>
          <a href="/pages/new-in">New In</a>
          <a href="/pages/designers">Designers</a>
          <a href="/pages/clothing">Clothing</a>
          <a href="/collections/handbags">Handbags</a>
          <a href="/pages/accessories">Accessories</a>
        </div>

        <div class="site-footer__col">
          <div class="site-footer__col-title">HELP</div>
          <a href="/pages/shipping-delivery">Shipping & Delivery</a>
          <a href="/pages/returns-refunds">Returns & Refunds</a>
          <a href="/pages/size-guide">Size Guide</a>
          <a href="/pages/contact">Contact</a>
        </div>
      </div>
    </div>
    <div class="site-footer__rule"></div>
    <div class="site-footer__bottom">
      <div class="site-footer__copy">© {{ 'now' | date: '%Y' }} ELARA IVY CO. ALL RIGHTS RESERVED.</div>
      <div class="site-footer__copy">INSTAGRAM · PINTEREST · TIKTOK</div>
    </div>
  </footer>

  <style>
    .site-footer { background-color: #0D1B3E; }
    .site-footer__logo { font-family: 'Jost', sans-serif; font-size: 13px; font-weight: 400; letter-spacing: 0.25em; color: #ffffff; }
    .site-footer__tagline { font-family: 'Cormorant Garamond', Georgia, serif; font-size: 13px; font-style: italic; color: rgba(255,255,255,0.5); margin-top: 8px; line-height: 1.7; }
    .site-footer__col-title { font-family: 'Jost', sans-serif; font-size: 10px; font-weight: 400; letter-spacing: 0.25em; color: #ffffff; margin-bottom: 14px; }
    .site-footer__col a { display: block; font-family: 'Jost', sans-serif; font-size: 13px; font-weight: 300; color: rgba(255,255,255,0.65); text-decoration: none; margin-bottom: 10px; letter-spacing: 0.03em; transition: color 0.2s ease; }
    .site-footer__col a:hover { color: #CFAE70; }
    .site-footer__rule { border-top: 1px solid rgba(255,255,255,0.1); }
    .site-footer__copy { font-family: 'Jost', sans-serif; font-size: 11px; font-weight: 300; letter-spacing: 0.15em; color: rgba(255,255,255,0.35); }
  </style>

  {{ 'elara-ivy.js' | asset_url | script_tag }}
</body>
</html>




