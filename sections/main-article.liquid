<div class="section section--white" style="max-width:720px;">
  <div class="breadcrumb" style="padding:0 0 24px;">
    <a href="{{ blog.url }}">{{ blog.title }}</a> ›
    <span class="current">{{ article.title }}</span>
  </div>
  {% if article.image %}
    <img src="{{ article.image | img_url: '1200x' }}" alt="{{ article.image.alt }}" style="width:100%;margin-bottom:32px;">
  {% endif %}
  <h1 class="ei-serif" style="font-size:40px;font-style:italic;font-weight:300;color:var(--navy);margin-bottom:12px;">{{ article.title }}</h1>
  <div style="font-size:9px;letter-spacing:0.18em;color:var(--periwinkle);margin-bottom:32px;">{{ article.published_at | date: '%B %d, %Y' }}</div>
  <div style="font-size:14px;line-height:1.95;color:var(--ink-body);">{{ article.content }}</div>
</div>

{% schema %}
{
  "name": "Article",
  "settings": [],
  "presets": [{ "name": "Article" }]
}
{% endschema %}
