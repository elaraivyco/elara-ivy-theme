<div class="ei-password-page">

  <div class="ei-password-page__inner">

    <p class="ei-password-page__brand">ELARA IVY CO.</p>

    <div class="ei-password-page__content">
      <h1 class="ei-password-page__headline">Curating something special.</h1>
      <p class="ei-password-page__subline">
        We're carefully selecting the pieces that belong in your wardrobe.<br>
        New collections, arriving soon.
      </p>
    </div>

    <div class="ei-password-page__divider"></div>

    <div class="ei-password-page__email-section">
      <p class="ei-password-page__form-label">Be the first to know</p>
      {% form 'customer', class: 'ei-password-page__email-form' %}
        <input type="hidden" name="contact[tags]" value="newsletter,password-page">
        <div class="ei-password-page__email-row">
          <input
            type="email"
            name="contact[email]"
            class="ei-password-page__email-input"
            placeholder="Your email address"
            autocomplete="email"
            required
            aria-label="Email address"
          >
          <button type="submit" class="ei-password-page__email-btn">Notify me</button>
        </div>
        {% if form.posted_successfully? %}
          <p class="ei-password-page__success">You're on the list. We'll be in touch.</p>
        {% endif %}
        {% if form.errors %}
          <p class="ei-password-page__error">{{ form.errors | default_errors }}</p>
        {% endif %}
      {% endform %}
    </div>

    <div class="ei-password-page__divider"></div>

    <div class="ei-password-page__enter-section">
      <p class="ei-password-page__enter-label">Have a password? Enter here.</p>
      {% form 'storefront_password', class: 'ei-password-page__enter-form' %}
        <div class="ei-password-page__enter-row">
          <input
            type="password"
            name="password"
            class="ei-password-page__enter-input"
            placeholder="Enter password"
            aria-label="Password"
          >
          <button type="submit" class="ei-password-page__enter-btn">ENTER</button>
        </div>
        {% if form.errors %}
          <p class="ei-password-page__error">{{ form.errors | default_errors }}</p>
        {% endif %}
      {% endform %}
    </div>

  </div>

</div>

<style>
  .ei-password-page {
    min-height: 100vh;
    background-color: #0D1B3E;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 60px 24px;
    font-family: 'Jost', sans-serif;
  }

  .ei-password-page__inner {
    max-width: 520px;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 32px;
  }

  .ei-password-page__brand {
    font-family: 'Jost', sans-serif;
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0.25em;
    color: rgba(255,255,255,0.9);
  }

  .ei-password-page__headline {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(32px, 5vw, 46px);
    font-weight: 300;
    font-style: italic;
    color: #ffffff;
    line-height: 1.2;
    margin-bottom: 16px;
  }

  .ei-password-page__subline {
    font-size: 13px;
    font-weight: 300;
    color: rgba(255,255,255,0.6);
    line-height: 1.85;
    letter-spacing: 0.02em;
  }

  .ei-password-page__divider {
    width: 40px;
    height: 1px;
    background: rgba(207,174,112,0.4);
  }

  .ei-password-page__form-label,
  .ei-password-page__enter-label {
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: #CFAE70;
    margin-bottom: 14px;
  }

  .ei-password-page__email-section,
  .ei-password-page__enter-section {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .ei-password-page__email-form,
  .ei-password-page__enter-form {
    width: 100%;
  }

  .ei-password-page__email-row,
  .ei-password-page__enter-row {
    display: flex;
    width: 100%;
    border: 1px solid rgba(255,255,255,0.2);
    border-radius: 1px;
    overflow: hidden;
    transition: border-color 0.2s ease;
  }

  .ei-password-page__email-row:focus-within,
  .ei-password-page__enter-row:focus-within {
    border-color: rgba(207,174,112,0.6);
  }

  .ei-password-page__email-input,
  .ei-password-page__enter-input {
    flex: 1;
    padding: 14px 18px;
    font-family: 'Jost', sans-serif;
    font-size: 13px;
    font-weight: 300;
    color: #ffffff;
    background: rgba(255,255,255,0.06);
    border: none;
    outline: none;
    min-width: 0;
  }

  .ei-password-page__email-input::placeholder,
  .ei-password-page__enter-input::placeholder {
    color: rgba(255,255,255,0.35);
  }

  .ei-password-page__email-btn {
    padding: 14px 22px;
    font-family: 'Jost', sans-serif;
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #0D1B3E;
    background-color: #CFAE70;
    border: none;
    cursor: pointer;
    white-space: nowrap;
    flex-shrink: 0;
    transition: opacity 0.2s ease;
  }

  .ei-password-page__email-btn:hover {
    opacity: 0.85;
  }

  .ei-password-page__enter-btn {
    padding: 14px 22px;
    font-family: 'Jost', sans-serif;
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.8);
    background: transparent;
    border: none;
    border-left: 1px solid rgba(255,255,255,0.2);
    cursor: pointer;
    white-space: nowrap;
    flex-shrink: 0;
    transition: color 0.2s ease;
  }

  .ei-password-page__enter-btn:hover {
    color: #ffffff;
  }

  .ei-password-page__success {
    font-size: 12px;
    color: rgba(207,174,112,0.9);
    letter-spacing: 0.05em;
    margin-top: 12px;
  }

  .ei-password-page__error {
    font-size: 12px;
    color: #F3C7D3;
    letter-spacing: 0.05em;
    margin-top: 12px;
  }

  @media (max-width: 480px) {
    .ei-password-page__email-row,
    .ei-password-page__enter-row {
      flex-direction: column;
    }

    .ei-password-page__email-btn,
    .ei-password-page__enter-btn {
      border-left: none;
      border-top: 1px solid rgba(255,255,255,0.15);
      padding: 12px;
    }
  }
</style>

{% schema %}
{
  "name": "Password page",
  "settings": [],
  "presets": [{ "name": "Password page" }]
}
{% endschema %}

