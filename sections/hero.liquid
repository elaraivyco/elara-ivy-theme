<div class="hero">
  <div class="hero__media">
    {% if section.settings.hero_image %}
      <img src="{{ section.settings.hero_image | img_url: '1400x' }}" alt="{{ section.settings.hero_image.alt | escape }}" loading="eager">
    {% else %}
      <div style="width:100%;height:100%;background:var(--navy-mid);display:flex;align-items:center;justify-content:center;">
        <span style="font-size:10px;letter-spacing:0.14em;color:rgba(255,255,255,0.18);">ADD HERO IMAGE IN THEME EDITOR</span>
      </div>
    {% endif %}
    {% if section.settings.badge_name != blank %}
      <div class="hero__badge">
        <div class="hero__badge-label">FEATURED DESIGNER</div>
        <div class="hero__badge-name ei-serif">{{ section.settings.badge_name }}</div>
      </div>
    {% endif %}
  </div>
  <div class="hero__content">
    {% if section.settings.eyebrow != blank %}
      <div class="hero__eyebrow">{{ section.settings.eyebrow }}</div>
    {% endif %}
    <h1 class="hero__heading ei-serif">{{ section.settings.heading }}</h1>
    {% if section.settings.subheading != blank %}
      <p class="hero__body">{{ section.settings.subheading }}</p>
    {% endif %}
    <div class="hero__ctas">
      {% if section.settings.cta_primary_label != blank %}
        <a href="{{ section.settings.cta_primary_url }}" class="btn-primary">{{ section.settings.cta_primary_label }}</a>
      {% endif %}
      {% if section.settings.cta_secondary_label != blank %}
        <a href="{{ section.settings.cta_secondary_url }}" class="btn-secondary">{{ section.settings.cta_secondary_label }}</a>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "hero_image", "label": "Hero image" },
    { "type": "text", "id": "badge_name", "label": "Featured designer badge", "default": "Jacquemus" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow text", "default": "SS26 COLLECTION — NOW LANDING" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The season's most coveted arrivals." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Curated from the world's finest designers. Each piece selected for its craftsmanship, story, and undeniable presence." },
    { "type": "text", "id": "cta_primary_label", "label": "Primary CTA label", "default": "EXPLORE THE EDIT" },
    { "type": "url", "id": "cta_primary_url", "label": "Primary CTA link" },
    { "type": "text", "id": "cta_secondary_label", "label": "Secondary CTA label", "default": "SHOP DESIGNERS" },
    { "type": "url", "id": "cta_secondary_url", "label": "Secondary CTA link" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
