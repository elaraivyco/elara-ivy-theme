{% comment %} sections/size-guide.liquid {% endcomment %}

<!-- HERO -->
<div style="background:var(--navy);padding:64px 24px 56px;">
  <div style="font-size:9px;letter-spacing:0.32em;color:var(--periwinkle);margin-bottom:16px;">FIT GUIDE</div>
  <h1 class="ei-serif" style="font-size:44px;line-height:1.06;color:#fff;font-weight:300;font-style:italic;margin-bottom:20px;">Find Your Perfect Fit.</h1>
  <p style="font-size:13px;color:rgba(255,255,255,0.5);line-height:1.85;max-width:520px;">Every designer we carry fits a little differently. Use this guide alongside individual product size notes for the most accurate fit.</p>
</div>

<!-- MARQUEE -->
<div class="marquee">
  <div class="marquee__track">
    <span>US · UK · EU SIZING</span><span class="dot">·</span>
    <span>CLOTHING & SWIMWEAR</span><span class="dot">·</span>
    <span>HOW TO MEASURE</span><span class="dot">·</span>
    <span>DESIGNER FIT NOTES</span><span class="dot">·</span>
    <span>US · UK · EU SIZING</span><span class="dot">·</span>
    <span>CLOTHING & SWIMWEAR</span><span class="dot">·</span>
    <span>HOW TO MEASURE</span><span class="dot">·</span>
    <span>DESIGNER FIT NOTES</span><span class="dot">·</span>
  </div>
</div>

<!-- HOW TO MEASURE -->
<div style="background:var(--white);padding:56px 24px;">
  <div style="font-size:8px;letter-spacing:0.3em;color:var(--periwinkle);margin-bottom:16px;text-transform:uppercase;">BEFORE YOU START</div>
  <h2 class="ei-serif" style="font-size:32px;font-style:italic;font-weight:300;color:var(--navy);margin-bottom:28px;">How to measure yourself</h2>
  <div style="display:grid;grid-template-columns:1fr;gap:3px;max-width:720px;">

    <div style="background:var(--surface-warm);padding:22px 24px;display:flex;gap:20px;align-items:flex-start;border-top:2px solid var(--periwinkle);">
      <div style="font-family:'Cormorant Garamond',serif;font-size:32px;font-weight:300;color:var(--periwinkle);opacity:0.5;line-height:1;flex-shrink:0;">B</div>
      <div>
        <div style="font-size:9px;letter-spacing:0.18em;color:var(--navy);margin-bottom:6px;">BUST</div>
        <div style="font-size:12px;color:var(--ink-muted);line-height:1.7;">Measure around the fullest part of your chest, keeping the tape parallel to the ground. Do not pull too tight.</div>
      </div>
    </div>

    <div style="background:var(--surface-warm);padding:22px 24px;display:flex;gap:20px;align-items:flex-start;border-top:2px solid var(--periwinkle);">
      <div style="font-family:'Cormorant Garamond',serif;font-size:32px;font-weight:300;color:var(--periwinkle);opacity:0.5;line-height:1;flex-shrink:0;">W</div>
      <div>
        <div style="font-size:9px;letter-spacing:0.18em;color:var(--navy);margin-bottom:6px;">WAIST</div>
        <div style="font-size:12px;color:var(--ink-muted);line-height:1.7;">Measure around your natural waistline — the narrowest part of your torso, usually just above your belly button.</div>
      </div>
    </div>

    <div style="background:var(--surface-warm);padding:22px 24px;display:flex;gap:20px;align-items:flex-start;border-top:2px solid var(--periwinkle);">
      <div style="font-family:'Cormorant Garamond',serif;font-size:32px;font-weight:300;color:var(--periwinkle);opacity:0.5;line-height:1;flex-shrink:0;">H</div>
      <div>
        <div style="font-size:9px;letter-spacing:0.18em;color:var(--navy);margin-bottom:6px;">HIPS</div>
        <div style="font-size:12px;color:var(--ink-muted);line-height:1.7;">Measure around the fullest part of your hips and seat, approximately 20cm below your natural waist.</div>
      </div>
    </div>

  </div>
  <div style="background:#FFF8EC;border-left:3px solid var(--gold);padding:16px 20px;margin-top:16px;max-width:720px;">
    <div style="font-size:12px;color:var(--ink-body);line-height:1.7;">Use a soft fabric measuring tape and measure in centimetres for the most accurate reading. If between sizes, we recommend sizing up.</div>
  </div>
</div>

<!-- CLOTHING SIZE CHART -->
<div style="background:var(--surface-warm);padding:56px 24px;">
  <div style="font-size:8px;letter-spacing:0.3em;color:var(--periwinkle);margin-bottom:16px;text-transform:uppercase;">WOMEN'S CLOTHING</div>
  <h2 class="ei-serif" style="font-size:32px;font-style:italic;font-weight:300;color:var(--navy);margin-bottom:28px;">Clothing Size Conversion</h2>
  <div style="overflow-x:auto;-webkit-overflow-scrolling:touch;">
    <table style="width:100%;border-collapse:collapse;min-width:560px;font-size:12px;">
      <thead>
        <tr style="background:var(--navy);">
          <th style="padding:14px 16px;text-align:left;font-size:8px;letter-spacing:0.2em;color:rgba(255,255,255,0.6);font-weight:400;">US</th>
          <th style="padding:14px 16px;text-align:left;font-size:8px;letter-spacing:0.2em;color:rgba(255,255,255,0.6);font-weight:400;">UK</th>
          <th style="padding:14px 16px;text-align:left;font-size:8px;letter-spacing:0.2em;color:rgba(255,255,255,0.6);font-weight:400;">EU</th>
          <th style="padding:14px 16px;text-align:left;font-size:8px;letter-spacing:0.2em;color:rgba(255,255,255,0.6);font-weight:400;">BUST (CM)</th>
          <th style="padding:14px 16px;text-align:left;font-size:8px;letter-spacing:0.2em;color:rgba(255,255,255,0.6);font-weight:400;">WAIST (CM)</th>
          <th style="padding:14px 16px;text-align:left;font-size:8px;letter-spacing:0.2em;color:rgba(255,255,255,0.6);font-weight:400;">HIPS (CM)</th>
        </tr>
      </thead>
      <tbody>
        {% assign clothing_sizes = "XS,6,34,79-81,61-63,86-88|S,8,36,84-86,64-66,89-91|M,10,38,89-91,69-71,94-96|L,12,40,94-96,74-76,99-101|XL,14,42,99-101,79-81,104-106|XXL,16,44,104-106,84-86,109-111" | split: "|" %}
        {% for row in clothing_sizes %}
          {% assign cols = row | split: "," %}
          <tr style="border-bottom:1px solid var(--rule);background:{% cycle 'var(--white)', 'var(--surface-warm)' %};">
            <td style="padding:14px 16px;color:var(--navy);font-family:'Cormorant Garamond',serif;font-size:16px;font-style:italic;font-weight:300;">{{ cols[0] }}</td>
            <td style="padding:14px 16px;color:var(--ink-body);">{{ cols[1] }}</td>
            <td style="padding:14px 16px;color:var(--ink-body);">{{ cols[2] }}</td>
            <td style="padding:14px 16px;color:var(--ink-muted);">{{ cols[3] }}</td>
            <td style="padding:14px 16px;color:var(--ink-muted);">{{ cols[4] }}</td>
            <td style="padding:14px 16px;color:var(--ink-muted);">{{ cols[5] }}</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>

