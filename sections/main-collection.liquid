<div class="ei-col">

  <div class="ei-col__hero">
    <p class="ei-col__eyebrow">{{ collection.title }}</p>
    <h1 class="ei-col__headline">{{ collection.title }}</h1>
    <div class="ei-col__meta">
      <span>{{ collection.products_count }} pieces</span>
      <span class="ei-col__dot">·</span>
      <span>Worldwide shipping</span>
      <span class="ei-col__dot">·</span>
      <span>Returns within 14 days</span>
    </div>
  </div>

  <div class="ei-col__filter-bar">
    <div class="ei-col__filters">
      <span class="ei-col__filter-label">Filter</span>
      <button class="ei-col__pill ei-col__pill--active" data-filter="all">All</button>
      <button class="ei-col__pill" data-filter="bags">Bags</button>
      <button class="ei-col__pill" data-filter="shoes">Shoes</button>
      <button class="ei-col__pill" data-filter="clothing">Clothing</button>
      <button class="ei-col__pill" data-filter="accessories">Accessories</button>
      <button class="ei-col__pill" data-filter="swimwear">Swimwear</button>
      <button class="ei-col__pill" data-filter="jewellery">Jewellery</button>
    </div>
    <div class="ei-col__sort">
      <span class="ei-col__filter-label">Sort</span>
      <select class="ei-col__sort-select" id="ei-col-sort">
        <option value="best-selling">Best selling</option>
        <option value="price-asc">Price: low to high</option>
        <option value="price-desc">Price: high to low</option>
        <option value="title-asc">Name A–Z</option>
        <option value="newest">Newest first</option>
      </select>
    </div>
  </div>

  <div class="ei-col__grid" id="ei-col-grid">
    {%- for product in collection.products -%}
      {%- assign tags = product.tags | join: ',' | downcase -%}
      {%- assign ptype = product.type | downcase -%}
      {%- assign fv = '' -%}
      {%- if tags contains 'bag' or ptype contains 'bag' or ptype contains 'tote' or ptype contains 'handbag' or ptype contains 'clutch' or ptype contains 'backpack' or ptype contains 'crossbody' -%}{%- assign fv = fv | append: 'bags ' -%}{%- endif -%}
      {%- if tags contains 'shoe' or tags contains 'heel' or tags contains 'sneaker' or tags contains 'sandal' or tags contains 'boot' or ptype contains 'shoe' or ptype contains 'heel' or ptype contains 'sneaker' or ptype contains 'sandal' or ptype contains 'boot' or ptype contains 'loafer' or ptype contains 'flat' -%}{%- assign fv = fv | append: 'shoes ' -%}{%- endif -%}
      {%- if tags contains 'clothing' or ptype contains 'dress' or ptype contains 'top' or ptype contains 'shirt' or ptype contains 'trouser' or ptype contains 'skirt' or ptype contains 'jacket' or ptype contains 'coat' or ptype contains 'knitwear' or ptype contains 'denim' or ptype contains 'jean' -%}{%- assign fv = fv | append: 'clothing ' -%}{%- endif -%}
      {%- if tags contains 'accessory' or tags contains 'accessories' or ptype contains 'scarf' or ptype contains 'belt' or ptype contains 'wallet' or ptype contains 'sunglass' or ptype contains 'hat' or ptype contains 'glove' -%}{%- assign fv = fv | append: 'accessories ' -%}{%- endif -%}
      {%- if tags contains 'swim' or ptype contains 'swim' or ptype contains 'bikini' or ptype contains 'one-piece' -%}{%- assign fv = fv | append: 'swimwear ' -%}{%- endif -%}
      {%- if tags contains 'jewel' or ptype contains 'jewel' or ptype contains 'necklace' or ptype contains 'earring' or ptype contains 'ring' or ptype contains 'bracelet' -%}{%- assign fv = fv | append: 'jewellery ' -%}{%- endif -%}

      <a href="{{ product.url }}" class="ei-col__card" data-fv="{{ fv | strip }}" data-price="{{ product.price }}" data-title="{{ product.title | escape }}">
        <div class="ei-col__card-img">
          {%- if product.featured_image -%}
            <img src="{{ product.featured_image | img_url: '400x533', crop: 'center' }}" alt="{{ product.featured_image.alt | escape }}" loading="lazy" width="400" height="533">
          {%- else -%}
            <div class="ei-col__card-placeholder"></div>
          {%- endif -%}
          {%- if product.tags contains 'New In' -%}
            <div class="ei-col__card-badge">New In</div>
          {%- endif -%}
        </div>
        <div class="ei-col__card-body">
          <p class="ei-col__card-vendor">{{ product.vendor }}</p>
          <p class="ei-col__card-title">{{ product.title }}</p>
          <p class="ei-col__card-price">{%- if product.price_varies -%}From {{ product.price_min | money }}{%- else -%}{{ product.price | money }}{%- endif -%}</p>
        </div>
      </a>
    {%- else -%}
      <div class="ei-col__empty"><p>No products found in this collection.</p></div>
    {%- endfor -%}
  </div>

  {%- if paginate.pages > 1 -%}
    <div class="ei-col__pagination">
      {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}" class="ei-col__page-btn">← Previous</a>{%- endif -%}
      <span class="ei-col__page-info">Page {{ paginate.current_page }} of {{ paginate.pages }}</span>
      {%- if paginate.next -%}<a href="{{ paginate.next.url }}" class="ei-col__page-btn">Next →</a>{%- endif -%}
    </div>
  {%- endif -%}

</div>

<style>
.ei-col{font-family:'Jost',sans-serif;color:#0D1B3E}
.ei-col__hero{background:#0D1B3E;padding:64px 48px 56px;text-align:center;background-image:radial-gradient(ellipse at 80% 20%,rgba(207,174,112,.07) 0%,transparent 55%),radial-gradient(ellipse at 20% 80%,rgba(243,199,211,.05) 0%,transparent 55%)}
.ei-col__eyebrow{font-size:10px;letter-spacing:.35em;text-transform:uppercase;color:#CFAE70;margin-bottom:12px}
.ei-col__headline{font-family:'Cormorant Garamond',Georgia,serif;font-size:clamp(40px,6vw,64px);font-weight:300;font-style:italic;color:#fff;line-height:1.1;margin-bottom:16px}
.ei-col__subline{font-size:14px;font-weight:300;color:rgba(255,255,255,.55);line-height:1.85;max-width:520px;margin:0 auto 20px}
.ei-col__meta{display:flex;align-items:center;justify-content:center;gap:12px;font-size:11px;letter-spacing:.1em;color:rgba(255,255,255,.35);text-transform:uppercase;flex-wrap:wrap}
.ei-col__dot{opacity:.4}
.ei-col__filter-bar{background:#F5F3F0;padding:14px 48px;display:flex;align-items:center;gap:10px;flex-wrap:wrap;border-bottom:1px solid #E8E4DF;position:sticky;top:0;z-index:10}
.ei-col__filters{display:flex;align-items:center;gap:8px;flex:1;flex-wrap:wrap}
.ei-col__filter-label{font-size:10px;letter-spacing:.2em;text-transform:uppercase;color:#999;margin-right:4px;flex-shrink:0}
.ei-col__pill{font-family:'Jost',sans-serif;font-size:12px;padding:5px 14px;border-radius:20px;border:1px solid #D8D4CE;background:transparent;color:#666;cursor:pointer;transition:all .15s ease;white-space:nowrap}
.ei-col__pill:hover{border-color:#0D1B3E;color:#0D1B3E}
.ei-col__pill--active{background:#0D1B3E;color:#fff;border-color:#0D1B3E}
.ei-col__sort{display:flex;align-items:center;gap:8px;flex-shrink:0}
.ei-col__sort-select{font-family:'Jost',sans-serif;font-size:12px;border:1px solid #D8D4CE;border-radius:2px;padding:6px 12px;background:#fff;color:#0D1B3E;outline:none}
.ei-col__grid{display:grid;grid-template-columns:repeat(5,1fr);gap:16px;padding:24px 48px;background:transparent}
.ei-col__card{display:block;text-decoration:none;color:inherit;background:#fff;transition:all .2s ease;border:1px solid #E8E4DF;border-radius:2px}
.ei-col__card:hover{background:#FAFAF8;box-shadow:0 4px 16px rgba(13,27,62,.1);transform:translateY(-2px)}
.ei-col__card:hover img{transform:scale(1.03)}
.ei-col__card.ei-hidden{display:none}
.ei-col__card-img{position:relative;aspect-ratio:3/4;overflow:hidden;background:#F5F3F0;max-height:320px}
.ei-col__card-img img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .5s ease}
.ei-col__card-placeholder{width:100%;height:100%;background:#F0EDE8}
.ei-col__card-badge{position:absolute;top:10px;left:10px;font-size:9px;letter-spacing:.2em;text-transform:uppercase;color:#CFAE70;background:rgba(13,27,62,.8);padding:3px 8px;border-radius:2px}
.ei-col__card-body{padding:14px 16px 16px;border-top:2px solid #0D1B3E;background:#fff}
.ei-col__card-vendor{font-size:9px;letter-spacing:.2em;text-transform:uppercase;color:#CFAE70;margin-bottom:4px;font-weight:500}
.ei-col__card-title{font-family:'Cormorant Garamond',Georgia,serif;font-size:15px;font-style:italic;color:#0D1B3E;margin-bottom:6px;line-height:1.25}
.ei-col__card-price{font-size:13px;font-weight:500;color:#0D1B3E;letter-spacing:.02em}
.ei-col__empty{grid-column:1/-1;text-align:center;padding:80px 24px;font-size:14px;color:#999;background:#fff}
.ei-col__pagination{display:flex;align-items:center;justify-content:center;gap:24px;padding:40px 24px;border-top:1px solid #E8E4DF}
.ei-col__page-btn{font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:#0D1B3E;text-decoration:none;border-bottom:1px solid #CFAE70;padding-bottom:2px;transition:color .2s ease}
.ei-col__page-btn:hover{color:#CFAE70}
.ei-col__page-info{font-size:12px;color:#999;letter-spacing:.1em}
@media(max-width:1024px){.ei-col__grid{grid-template-columns:repeat(4,1fr);padding:20px 24px}}
@media(max-width:768px){.ei-col__hero{padding:40px 24px 32px}.ei-col__filter-bar{padding:12px 16px}.ei-col__grid{grid-template-columns:repeat(2,1fr);padding:16px}}
@media(max-width:480px){.ei-col__grid{grid-template-columns:repeat(2,1fr)}}
</style>

<script>
document.addEventListener('DOMContentLoaded',function(){
  var pills=document.querySelectorAll('.ei-col__pill');
  var cards=Array.from(document.querySelectorAll('.ei-col__card'));
  var sort=document.getElementById('ei-col-sort');
  var grid=document.getElementById('ei-col-grid');

  pills.forEach(function(pill){
    pill.addEventListener('click',function(){
      pills.forEach(function(p){p.classList.remove('ei-col__pill--active')});
      pill.classList.add('ei-col__pill--active');
      var f=pill.getAttribute('data-filter');
      cards.forEach(function(c){
        if(f==='all'){c.classList.remove('ei-hidden')}
        else{var v=c.getAttribute('data-fv')||'';v.indexOf(f)>-1?c.classList.remove('ei-hidden'):c.classList.add('ei-hidden')}
      });
    });
  });

  if(sort){sort.addEventListener('change',function(){
    var m=this.value;
    var visible=cards.filter(function(c){return!c.classList.contains('ei-hidden')});
    visible.sort(function(a,b){
      if(m==='price-asc')return parseInt(a.dataset.price)-parseInt(b.dataset.price);
      if(m==='price-desc')return parseInt(b.dataset.price)-parseInt(a.dataset.price);
      if(m==='title-asc')return a.dataset.title.localeCompare(b.dataset.title);
      return 0;
    });
    visible.forEach(function(c){grid.appendChild(c)});
  });}
});
</script>

{% schema %}
{
  "name": "Collection Page",
  "settings": [],
  "presets": [{ "name": "Collection" }]
}
{% endschema %}
