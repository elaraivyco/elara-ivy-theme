<div class="section section--white">
  <div class="section__header">
    <h1 class="section__title ei-serif">{{ collection.title }}</h1>
  </div>
  {% if collection.description != blank %}
    <p class="section__sub">{{ collection.description }}</p>
  {% endif %}
  <div class="product-grid">
    {% for product in collection.products %}
      <div class="product-card">
        <a href="{{ product.url }}">
          <div class="product-card__media">
            {% if product.featured_image %}
              <img src="{{ product.featured_image | img_url: '600x' }}" alt="{{ product.featured_image.alt | escape }}" loading="lazy">
            {% endif %}
            {% if product.tags contains 'new' %}
              <span class="product-card__badge">NEW</span>
            {% endif %}
          </div>
          <div class="product-card__info">
            <div class="product-card__designer">{{ product.vendor | upcase }}</div>
            <div class="product-card__title ei-serif">{{ product.title }}</div>
            <div class="product-card__price">{{ product.price | money }}</div>
          </div>
        </a>
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Collection Page",
  "settings": [],
  "presets": [{ "name": "Collection" }]
}
{% endschema %}
