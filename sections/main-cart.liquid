<div class="section section--white">
  <h1 class="section__title ei-serif" style="margin-bottom:32px;">Your Bag</h1>
  {% if cart.item_count == 0 %}
    <p style="color:var(--ink-muted);font-size:13px;margin-bottom:24px;">Your bag is empty.</p>
    <a href="{{ routes.root_url }}" class="btn-primary">CONTINUE SHOPPING</a>
  {% else %}
    {% for item in cart.items %}
      <div style="display:flex;gap:20px;padding:20px 0;border-bottom:1px solid var(--rule);">
        <img src="{{ item.image | img_url: '200x' }}" alt="{{ item.title }}" style="width:100px;height:100px;object-fit:cover;">
        <div style="flex:1;">
          <div style="font-size:8px;letter-spacing:0.2em;color:var(--periwinkle);margin-bottom:4px;">{{ item.vendor | upcase }}</div>
          <div class="ei-serif" style="font-size:18px;font-style:italic;color:var(--navy);margin-bottom:6px;">{{ item.product_title }}</div>
          <div style="font-size:11px;color:var(--ink-muted);margin-bottom:8px;">{{ item.variant_title }}</div>
          <div style="font-size:14px;color:var(--ink);">{{ item.final_price | money }}</div>
        </div>
        <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity=0" style="font-size:10px;color:var(--ink-faint);align-self:flex-start;">Remove</a>
      </div>
    {% endfor %}

    <!-- DISCOUNT CODE -->
    <div style="padding:24px 0;border-bottom:1px solid var(--rule);">
      <div style="font-size:9px;letter-spacing:0.18em;color:var(--ink-muted);margin-bottom:12px;">DISCOUNT CODE</div>
      <div style="display:flex;gap:8px;">
        <input
          type="text"
          id="discount-code"
          placeholder="Enter code"
          style="flex:1;border:1px solid var(--rule);padding:12px 16px;font-size:12px;font-family:'Jost',sans-serif;letter-spacing:0.05em;color:var(--navy);outline:none;background:var(--white);"
        >
        <button
          onclick="applyDiscount()"
          style="background:var(--navy);color:#fff;border:none;padding:12px 20px;font-size:9px;letter-spacing:0.2em;font-family:'Jost',sans-serif;cursor:pointer;"
        >APPLY</button>
      </div>
      <div id="discount-msg" style="font-size:11px;margin-top:8px;color:var(--ink-muted);display:none;"></div>
    </div>

    <!-- TOTALS & ACTIONS -->
    <div style="padding:24px 0;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:16px;">
      <div>
        <div style="font-size:9px;letter-spacing:0.18em;color:var(--ink-muted);margin-bottom:4px;">SUBTOTAL</div>
        <div class="ei-serif" style="font-size:24px;color:var(--navy);">{{ cart.total_price | money }}</div>
        <div style="font-size:11px;color:var(--ink-muted);margin-top:4px;">Shipping & taxes calculated at checkout</div>
      </div>
      <div style="display:flex;gap:12px;align-items:center;flex-wrap:wrap;">
        <a href="{{ routes.root_url }}" style="font-size:11px;letter-spacing:0.15em;color:var(--ink-muted);text-decoration:none;border-bottom:1px solid var(--rule);padding-bottom:2px;">CONTINUE SHOPPING</a>
        <a href="/checkout" class="btn-primary">CHECKOUT</a>
      </div>
    </div>
  {% endif %}
</div>

<script>
function applyDiscount() {
  var code = document.getElementById('discount-code').value.trim();
  var msg = document.getElementById('discount-msg');
  if (!code) {
    msg.style.display = 'block';
    msg.style.color = 'var(--ink-muted)';
    msg.textContent = 'Please enter a discount code.';
    return;
  }
  window.location.href = '/checkout?discount=' + encodeURIComponent(code);
}
document.getElementById('discount-code').addEventListener('keydown', function(e) {
  if (e.key === 'Enter') applyDiscount();
});
</script>

{% schema %}
{
  "name": "Cart",
  "settings": [],
  "presets": [{ "name": "Cart" }]
}
{% endschema %}

