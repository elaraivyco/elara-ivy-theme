<div class="ei-des">

  <div class="ei-des__hero">
    <p class="ei-des__eyebrow">Our Curation</p>
    <h1 class="ei-des__headline">The Designers</h1>
    <p class="ei-des__subline">Every label we carry is here for a reason. A considered edit of the world's most exceptional designers — spanning heritage houses, contemporary icons, and emerging voices.</p>
    <div class="ei-des__meta">
      <span>43 designers</span>
      <span class="ei-des__dot">·</span>
      <span>New labels added seasonally</span>
      <span class="ei-des__dot">·</span>
      <span>Complimentary shipping over £200</span>
    </div>
  </div>

  <div class="ei-des__filter-bar">
    <div class="ei-des__filters">
      <span class="ei-des__filter-label">{{ collections | map: 'all_products_count' | sum }} pieces across all designers</span>
    </div>
    <div class="ei-des__sort">
      <span class="ei-des__filter-label">Sort</span>
      <select class="ei-des__sort-select" id="ei-des-sort">
        <option value="alpha">A – Z</option>
        <option value="alpha-desc">Z – A</option>
        <option value="products">Most products</option>
      </select>
    </div>
  </div>

  <div class="ei-des__grid" id="ei-des-grid">

    {%- assign designer_handles = 'adidas,alexander-wang,alice-olivia,balenciaga,birkenstock,bottega-veneta,burberry,cartier,casablanca,chanel,christian-dior,christian-louboutin,coach,cult-gaia,furla,golden-goose,gucci,hermes,hunza-g,kate-spade,khaite,loro-piana,louis-vuitton,marc-jacobs,max-mara,michael-kors,miu-miu,paige,philosophy,prada,saint-laurent,stella-mccartney,the-attico,the-row,tiffany-co,tom-ford,tory-burch,uma-wang,versace,victorias-secret,vivienne-westwood,wild-cashmere,windsor' | split: ',' -%}

    {%- assign designer_descriptors = 'Sportswear Icon,New York Edge,Contemporary Chic,Avant-Garde,German Craft,Italian Artistry,British Heritage,French Jewellery,Casablanca Resort,French Couture,French Heritage,Parisian Glamour,American Leather,LA Cool,Italian Spirit,Italian Cool,Italian Luxury,French Exclusivity,Resort Swimwear,New York Prep,New York Modern,Italian Cashmere,French Exclusivity,New York Cool,Italian Elegance,New York Classic,Italian Edge,American Denim,Italian Romance,Italian Heritage,French Luxury,British Sustainability,Italian Contemporary,Quiet Luxury,American Jewellery,American Tailoring,American Prep,Shanghai Modern,Italian Baroque,American Intimates,British Punk,Scottish Cashmere,American Occasion' | split: ',' -%}

    {%- for handle in designer_handles -%}
      {%- assign col = collections[handle] -%}
      {%- assign cat = designer_descriptors[forloop.index0] -%}
      {%- if col != blank -%}
        <a href="{{ col.url }}" class="ei-des__card" data-filter="{{ cat }}" data-title="{{ col.title }}" data-count="{{ col.products_count }}">
          <div class="ei-des__card-img">
            {%- if col.image -%}
              <img
                src="{{ col.image | img_url: '400x500', crop: 'center' }}"
                alt="{{ col.title }}"
                loading="lazy"
                width="400"
                height="500"
              >
            {%- else -%}
              <div class="ei-des__card-placeholder">
                <span class="ei-des__card-initial">{{ col.title | slice: 0 }}</span>
              </div>
            {%- endif -%}
            {%- if col.products_count == 0 -%}
              <div class="ei-des__card-coming">Coming soon</div>
            {%- else -%}
              <div class="ei-des__card-count">{{ col.products_count }} pieces</div>
            {%- endif -%}
          </div>
          <div class="ei-des__card-body">
            <p class="ei-des__card-cat">{{ cat }}</p>
            <p class="ei-des__card-name">{{ col.title }}</p>
            <p class="ei-des__card-cta">Shop collection →</p>
          </div>
        </a>
      {%- endif -%}
    {%- endfor -%}

  </div>

</div>

<style>
.ei-des{font-family:'Jost',sans-serif;color:#0D1B3E}
.ei-des__hero{background:#0D1B3E;padding:64px 48px 56px;text-align:center;background-image:radial-gradient(ellipse at 80% 20%,rgba(207,174,112,.07) 0%,transparent 55%),radial-gradient(ellipse at 20% 80%,rgba(243,199,211,.05) 0%,transparent 55%)}
.ei-des__eyebrow{font-size:10px;letter-spacing:.35em;text-transform:uppercase;color:#CFAE70;margin-bottom:12px}
.ei-des__headline{font-family:'Cormorant Garamond',Georgia,serif;font-size:clamp(40px,6vw,64px);font-weight:300;font-style:italic;color:#fff;line-height:1.1;margin-bottom:16px}
.ei-des__subline{font-size:14px;font-weight:300;color:rgba(255,255,255,.55);line-height:1.85;max-width:560px;margin:0 auto 20px}
.ei-des__meta{display:flex;align-items:center;justify-content:center;gap:12px;font-size:11px;letter-spacing:.1em;color:rgba(255,255,255,.35);text-transform:uppercase;flex-wrap:wrap}
.ei-des__dot{opacity:.4}
.ei-des__filter-bar{background:#F5F3F0;padding:14px 48px;display:flex;align-items:center;gap:10px;flex-wrap:wrap;border-bottom:1px solid #E8E4DF;position:sticky;top:0;z-index:10}
.ei-des__filters{display:flex;align-items:center;gap:8px;flex:1;flex-wrap:wrap}
.ei-des__filter-label{font-size:10px;letter-spacing:.2em;text-transform:uppercase;color:#999;margin-right:4px;flex-shrink:0}
.ei-des__pill{font-family:'Jost',sans-serif;font-size:12px;padding:5px 14px;border-radius:20px;border:1px solid #D8D4CE;background:transparent;color:#666;cursor:pointer;transition:all .15s ease;white-space:nowrap}
.ei-des__pill:hover{border-color:#0D1B3E;color:#0D1B3E}
.ei-des__pill--active{background:#0D1B3E;color:#fff;border-color:#0D1B3E}
.ei-des__sort{display:flex;align-items:center;gap:8px;flex-shrink:0}
.ei-des__sort-select{font-family:'Jost',sans-serif;font-size:12px;border:1px solid #D8D4CE;border-radius:2px;padding:6px 12px;background:#fff;color:#0D1B3E;outline:none}
.ei-des__grid{display:grid;grid-template-columns:repeat(5,1fr);gap:16px;padding:24px 48px;background:transparent}
.ei-des__card{display:block;text-decoration:none;color:inherit;background:#fff;border-radius:2px;overflow:hidden;transition:all .2s ease;border:1px solid #E8E4DF;box-shadow:0 1px 4px rgba(13,27,62,.06)}
.ei-des__card:hover{box-shadow:0 4px 20px rgba(13,27,62,.12);transform:translateY(-2px)}
.ei-des__card:hover img{transform:scale(1.04)}
.ei-des__card.ei-hidden{display:none}
.ei-des__card-img{position:relative;aspect-ratio:3/4;overflow:hidden;background:#F5F3F0;max-height:320px}
.ei-des__card-img img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .5s ease}
.ei-des__card-placeholder{width:100%;height:100%;background:#F0EDE8;display:flex;align-items:center;justify-content:center}
.ei-des__card-initial{font-family:'Cormorant Garamond',Georgia,serif;font-size:56px;font-weight:300;font-style:italic;color:#D4CFC8}
.ei-des__card-count{position:absolute;bottom:10px;left:10px;font-size:9px;letter-spacing:.15em;text-transform:uppercase;color:#fff;background:rgba(13,27,62,.7);padding:3px 8px;border-radius:2px;backdrop-filter:blur(4px)}
.ei-des__card-coming{position:absolute;bottom:10px;left:10px;font-size:9px;letter-spacing:.15em;text-transform:uppercase;color:#CFAE70;background:rgba(13,27,62,.7);padding:3px 8px;border-radius:2px}
.ei-des__card-body{padding:14px 16px 16px;border-top:2px solid #0D1B3E;background:#fff}
.ei-des__card-cat{font-size:9px;letter-spacing:.2em;text-transform:uppercase;color:#CFAE70;margin-bottom:4px;font-weight:500}
.ei-des__card-name{font-family:'Cormorant Garamond',Georgia,serif;font-size:15px;font-style:italic;color:#0D1B3E;margin-bottom:6px;line-height:1.25}
.ei-des__card-cta{font-size:10px;letter-spacing:.1em;color:#999;transition:color .2s ease}
.ei-des__card:hover .ei-des__card-cta{color:#0D1B3E}
@media(max-width:1024px){.ei-des__grid{grid-template-columns:repeat(4,1fr);padding:20px 24px}}
@media(max-width:768px){.ei-des__hero{padding:40px 24px 32px}.ei-des__filter-bar{padding:12px 16px}.ei-des__grid{grid-template-columns:repeat(2,1fr);padding:16px}}
@media(max-width:480px){.ei-des__grid{grid-template-columns:repeat(2,1fr)}}
</style>

<script>
document.addEventListener('DOMContentLoaded',function(){
  var pills=document.querySelectorAll('.ei-des__pill');
  var cards=Array.from(document.querySelectorAll('.ei-des__card'));
  var sort=document.getElementById('ei-des-sort');
  var grid=document.getElementById('ei-des-grid');

  pills.forEach(function(pill){
    pill.addEventListener('click',function(){
      pills.forEach(function(p){p.classList.remove('ei-des__pill--active')});
      pill.classList.add('ei-des__pill--active');
      var f=pill.getAttribute('data-filter');
      cards.forEach(function(c){
        if(f==='all'){c.classList.remove('ei-hidden')}
        else{c.getAttribute('data-filter')===f?c.classList.remove('ei-hidden'):c.classList.add('ei-hidden')}
      });
    });
  });

  if(sort){
    sort.addEventListener('change',function(){
      var m=this.value;
      var visible=cards.filter(function(c){return!c.classList.contains('ei-hidden')});
      visible.sort(function(a,b){
        if(m==='alpha')return a.dataset.title.localeCompare(b.dataset.title);
        if(m==='alpha-desc')return b.dataset.title.localeCompare(a.dataset.title);
        if(m==='products')return parseInt(b.dataset.count)-parseInt(a.dataset.count);
        return 0;
      });
      visible.forEach(function(c){grid.appendChild(c)});
    });
  }
});
</script>

{% schema %}
{
  "name": "Designers",
  "settings": [],
  "presets": [{ "name": "Designers" }]
}
{% endschema %}


