{% comment %} sections/shipping-info.liquid {% endcomment %}

<!-- HERO -->
<div style="background:var(--navy);padding:64px 24px 56px;text-align:center;">
  <div style="font-size:9px;letter-spacing:0.32em;color:var(--gold);margin-bottom:16px;text-transform:uppercase;">Customer Care</div>
  <h1 class="ei-serif" style="font-size:44px;line-height:1.06;color:#fff;font-weight:300;font-style:italic;margin-bottom:20px;">Shipping &amp; Delivery</h1>
  <p style="font-size:13px;color:rgba(255,255,255,0.6);line-height:1.85;max-width:480px;margin:0 auto 22px;">Each order is carefully processed and dispatched within 24–48 hours through our trusted fulfilment partners — DHL, FedEx, and UPS.</p>
  <div style="display:flex;align-items:center;justify-content:center;gap:10px;font-size:10px;letter-spacing:0.1em;color:rgba(255,255,255,0.4);text-transform:uppercase;flex-wrap:wrap;">
    <span>24–48hr processing</span><span style="opacity:0.4;">·</span>
    <span>Worldwide delivery</span><span style="opacity:0.4;">·</span>
    <span>5–7 day US delivery</span>
  </div>
</div>

<!-- AT A GLANCE -->
<div style="background:var(--white);padding:0 24px;">
  <div style="max-width:720px;margin:0 auto;display:flex;border-bottom:1px solid var(--rule-light);">
    <div style="flex:1;text-align:center;padding:32px 8px;border-right:1px solid var(--rule-light);">
      <div style="font-family:'Cormorant Garamond',serif;font-size:30px;font-style:italic;font-weight:300;color:var(--navy);">24–48</div>
      <div style="font-size:9px;letter-spacing:0.15em;text-transform:uppercase;color:var(--ink-muted);margin-top:4px;">Hours to dispatch</div>
    </div>
    <div style="flex:1;text-align:center;padding:32px 8px;border-right:1px solid var(--rule-light);">
      <div style="font-family:'Cormorant Garamond',serif;font-size:30px;font-style:italic;font-weight:300;color:var(--navy);">5–7</div>
      <div style="font-size:9px;letter-spacing:0.15em;text-transform:uppercase;color:var(--ink-muted);margin-top:4px;">US business days</div>
    </div>
    <div style="flex:1;text-align:center;padding:32px 8px;">
      <div style="font-family:'Cormorant Garamond',serif;font-size:30px;font-style:italic;font-weight:300;color:var(--navy);">Worldwide</div>
      <div style="font-size:9px;letter-spacing:0.15em;text-transform:uppercase;color:var(--ink-muted);margin-top:4px;">Destinations shipped</div>
    </div>
  </div>
</div>

<!-- ORDER PROCESSING -->
<div style="background:var(--surface-warm);padding:56px 24px;">
  <div style="max-width:720px;margin:0 auto;">
    <div style="font-size:9px;letter-spacing:0.2em;color:var(--periwinkle);margin-bottom:8px;text-transform:uppercase;">Order Processing</div>
    <h2 class="ei-serif" style="font-size:26px;font-style:italic;font-weight:300;color:var(--navy);margin-bottom:8px;">What happens after you order?</h2>
    <p style="font-size:13px;color:var(--ink-body);line-height:1.75;margin-bottom:20px;max-width:480px;">Orders are dispatched within 24–48 hours of placement. During peak periods or new collection launches, dispatch may take slightly longer.</p>
    <div style="display:flex;flex-direction:column;">
      {% assign steps = "Order verification|Quality checks|Packaging and fulfilment coordination|Dispatch via DHL, FedEx, or UPS within 24–48 hours" | split: "|" %}
      {% for step in steps %}
        <div style="display:flex;align-items:center;gap:14px;padding:12px 0;{% unless forloop.last %}border-bottom:1px solid var(--rule-light);{% endunless %}">
          <div style="width:22px;height:22px;border-radius:50%;background:var(--navy);color:#fff;font-size:11px;display:flex;align-items:center;justify-content:center;flex-shrink:0;">{{ forloop.index }}</div>
          <span style="font-size:13px;color:var(--navy);">{{ step }}</span>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

<!-- SHIPPING RATES -->
<div style="background:var(--white);padding:56px 24px;">
  <div style="max-width:720px;margin:0 auto;">
    <div style="font-size:9px;letter-spacing:0.2em;color:var(--periwinkle);margin-bottom:8px;text-transform:uppercase;">Shipping Rates</div>
    <h2 class="ei-serif" style="font-size:26px;font-style:italic;font-weight:300;color:var(--navy);margin-bottom:8px;">Rates by destination</h2>
    <p style="font-size:12px;color:var(--ink-muted);line-height:1.7;margin-bottom:16px;max-width:480px;">Economy and Express options are available at checkout. Final rates are displayed before payment. US orders are Delivered Duty Paid — no surprise customs fees on delivery.</p>

    <div style="border:1px solid var(--rule-light);">
      <div style="background:var(--navy);color:#fff;font-size:9px;letter-spacing:0.15em;text-transform:uppercase;padding:10px 16px;">Economy rates</div>

      <div style="display:flex;justify-content:space-between;align-items:center;padding:12px 16px;border-bottom:1px solid var(--rule-light);flex-wrap:wrap;gap:8px;">
        <div>
          <span style="font-size:13px;color:var(--navy);">United States</span>
          <span style="font-size:9px;letter-spacing:0.05em;text-transform:uppercase;background:var(--periwinkle-lt);color:var(--periwinkle);padding:2px 7px;margin-left:8px;border-radius:10px;">DDP · duties included</span>
        </div>
        <div style="text-align:right;">
          <div style="font-size:13px;color:var(--navy);">Free over $70 <span style="color:var(--ink-muted);">·</span> $16.99 <span style="color:var(--ink-muted);">·</span> Express $24.99</div>
          <div style="font-size:10px;color:var(--ink-faint);">5–7 business days</div>
        </div>
      </div>

      <div style="display:flex;justify-content:space-between;align-items:center;padding:12px 16px;border-bottom:1px solid var(--rule-light);background:var(--surface-warm);">
        <span style="font-size:13px;color:var(--navy);">Canada</span>
        <div style="text-align:right;">
          <div style="font-size:13px;color:var(--navy);">From $40.00</div>
          <div style="font-size:10px;color:var(--ink-faint);">5–8 business days</div>
        </div>
      </div>

      <div style="display:flex;justify-content:space-between;align-items:center;padding:12px 16px;border-bottom:1px solid var(--rule-light);">
        <span style="font-size:13px;color:var(--navy);">United Kingdom</span>
        <div style="text-align:right;">
          <div style="font-size:13px;color:var(--navy);">From $25.00</div>
          <div style="font-size:10px;color:var(--ink-faint);">5–7 business days</div>
        </div>
      </div>

      <div style="display:flex;justify-content:space-between;align-items:center;padding:12px 16px;border-bottom:1px solid var(--rule-light);background:var(--surface-warm);">
        <span style="font-size:13px;color:var(--navy);">European Union</span>
        <div style="text-align:right;">
          <div style="font-size:13px;color:var(--navy);">From $23.00</div>
          <div style="font-size:10px;color:var(--ink-faint);">2–5 business days</div>
        </div>
      </div>

      <div style="display:flex;justify-content:space-between;align-items:center;padding:12px 16px;border-bottom:1px solid var(--rule-light);">
        <span style="font-size:13px;color:var(--navy);">Australia &amp; New Zealand</span>
        <div style="text-align:right;">
          <div style="font-size:13px;color:var(--navy);">From $45.00</div>
          <div style="font-size:10px;color:var(--ink-faint);">5–8 business days</div>
        </div>
      </div>

      <div style="display:flex;justify-content:space-between;align-items:center;padding:12px 16px;border-bottom:1px solid var(--rule-light);background:var(--surface-warm);">
        <span style="font-size:13px;color:var(--navy);">Asia Pacific</span>
        <div style="text-align:right;">
          <div style="font-size:13px;color:var(--navy);">From $38.00</div>
          <div style="font-size:10px;color:var(--ink-faint);">5–8 business days</div>
        </div>
      </div>

      <div style="display:flex;justify-content:space-between;align-items:center;padding:12px 16px;">
        <span style="font-size:13px;color:var(--navy);">Rest of world</span>
        <div style="text-align:right;">
          <div style="font-size:13px;color:var(--navy);">From $50.00</div>
          <div style="font-size:10px;color:var(--ink-faint);">5–10 business days</div>
        </div>
      </div>
    </div>
    <p style="font-size:10px;color:var(--ink-faint);line-height:1.6;margin-top:12px;">Rates shown are starting Economy rates. Express options available at checkout for select destinations. Final rate depends on destination and item category. All orders dispatched within 24–48 hours.</p>
  </div>
</div>

<!-- COMMON QUESTIONS -->
<div style="background:var(--surface-warm);padding:56px 24px;">
  <div style="max-width:720px;margin:0 auto;">
    <div style="font-size:9px;letter-spacing:0.2em;color:var(--periwinkle);margin-bottom:8px;text-transform:uppercase;">Good To Know</div>
    <h2 class="ei-serif" style="font-size:26px;font-style:italic;font-weight:300;color:var(--navy);margin-bottom:20px;">Common questions</h2>
    <div style="display:flex;flex-direction:column;">
      {% assign faq_questions = "Why did my order arrive in parts?|How do I stay informed about my order?|What if there's a delay?|What if my package is marked delivered but I don't have it?|Can I change or cancel my order?" | split: "|" %}
      {% assign faq_answers = "Because we work with multiple trusted fulfilment partners, items in the same order may ship separately. You may receive multiple tracking numbers and packages may arrive on different days — this is completely normal for curated boutique fulfilment.|Once your order ships, you'll receive a tracking email with your carrier and tracking number. Please allow 24–48 hours for tracking to update after label creation. Customers are responsible for entering the correct shipping address — we are not responsible for delays or non-delivery due to address errors, and reshipping fees apply if an order is returned for this reason.|We are not responsible for delays caused by carrier issues, weather events, customs processing, holiday volume, or postal disruptions, but we will always help you track and investigate delayed shipments.|Once marked as delivered by the carrier, we are not liable for lost or stolen packages. We recommend checking with neighbours and your local carrier office first — you may file a carrier claim and we will assist with documentation.|Orders cannot be changed or cancelled once processing begins. If you contact us immediately after ordering, we will try — but cannot guarantee — cancellation before dispatch. Please email shop@elaraivyco.com right away if you need assistance." | split: "|" %}
      {% for question in faq_questions %}
        <div style="padding:14px 0;{% unless forloop.last %}border-bottom:1px solid var(--rule-light);{% endunless %}">
          <p class="ei-serif" style="font-size:14px;color:var(--navy);font-style:italic;margin-bottom:6px;">{{ question }}</p>
          <p style="font-size:12px;color:var(--ink-body);line-height:1.7;">{{ faq_answers[forloop.index0] }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

<!-- INTERNATIONAL / DUTIES -->
<div style="background:var(--blush);padding:56px 24px;">
  <div style="max-width:720px;margin:0 auto;">
    <div style="font-size:9px;letter-spacing:0.2em;color:var(--navy);opacity:0.6;margin-bottom:8px;text-transform:uppercase;">International Orders</div>
    <h2 class="ei-serif" style="font-size:26px;font-style:italic;font-weight:300;color:var(--navy);margin-bottom:14px;">Duties &amp; taxes</h2>
    <p style="font-size:13px;color:var(--navy);line-height:1.8;margin-bottom:14px;"><strong>United States:</strong> All US orders are shipped Delivered Duty Paid (DDP). Customs duties are pre-paid on your behalf — you will not receive any surprise fees at delivery.</p>
    <p style="font-size:13px;color:var(--navy);line-height:1.8;margin-bottom:14px;"><strong>All other destinations:</strong> International shipments may be subject to import duties, taxes, and customs fees determined by local regulations. These charges are the customer's responsibility and are not included in our prices or shipping fees.</p>
    <p style="font-size:13px;color:var(--navy);line-height:1.8;">We recommend checking with your local customs authority for estimated charges before placing your order.</p>
  </div>
</div>

<!-- CLOSING CTA -->
<div style="background:var(--navy);padding:56px 24px;text-align:center;">
  <div style="max-width:480px;margin:0 auto;">
    <h2 class="ei-serif" style="font-size:24px;font-style:italic;font-weight:300;color:#fff;margin-bottom:10px;">Questions about your order?</h2>
    <p style="font-size:12px;color:rgba(255,255,255,0.5);line-height:1.75;margin-bottom:22px;">Our team is happy to help with any shipping questions or concerns.</p>
    <a href="mailto:shop@elaraivyco.com" style="display:inline-block;background:#fff;color:var(--navy);font-size:10px;letter-spacing:0.2em;padding:12px 24px;text-decoration:none;">EMAIL US</a>
  </div>
</div>

{% schema %}
{
  "name": "Shipping Info",
  "settings": [],
  "presets": [{ "name": "Shipping Info" }]
}
{% endschema %}
