<section class="section section--white">
  <div class="section__header">
    <h2 class="section__title ei-serif">{{ section.settings.heading }}</h2>
    {% if section.settings.view_all_url != blank %}
      <a href="{{ section.settings.view_all_url }}" class="section__link">VIEW ALL</a>
    {% endif %}
  </div>
  {% if section.settings.subheading != blank %}
    <p class="section__sub">{{ section.settings.subheading }}</p>
  {% endif %}

  {%- assign designer_handles = 'adidas,alexander-wang,alice-olivia,birkenstock,bottega-veneta,burberry,cartier,casablanca,chanel,chloe,christian-dior,christian-louboutin,coach,cult-gaia,furla,golden-goose,gucci,hermes,hunza-g,isabel-marant,kate-spade,khaite,loro-piana,louis-vuitton,marc-jacobs,max-mara,michael-kors,miu-miu,paige,philosophy,prada,saint-laurent,stella-mccartney,the-attico,the-row,tiffany-co,tom-ford,tory-burch,uma-wang,valentino,versace,victorias-secret,vivienne-westwood,wild-cashmere,windsor' | split: ',' -%}
  {%- assign designer_descriptors = 'Sportswear Icon,New York Edge,Contemporary Chic,German Craft,Italian Artistry,British Heritage,French Jewellery,Casablanca Resort,French Couture,French Romanticism,French Heritage,Parisian Glamour,American Leather,LA Cool,Italian Spirit,Italian Cool,Italian Luxury,French Exclusivity,Resort Swimwear,Parisian Cool,New York Prep,New York Modern,Italian Cashmere,French Exclusivity,New York Cool,Italian Elegance,New York Classic,Italian Edge,American Denim,Italian Romance,Italian Heritage,French Luxury,British Sustainability,Italian Contemporary,Quiet Luxury,American Jewellery,American Tailoring,American Prep,Shanghai Modern,Italian Romanticism,Italian Baroque,American Intimates,British Punk,Scottish Cashmere,American Occasion' | split: ',' -%}

  {%- assign sortable = '' -%}
  {%- for handle in designer_handles -%}
    {%- assign col = collections[handle] -%}
    {%- if col != blank and col.products_count > 0 -%}
      {%- assign cat = designer_descriptors[forloop.index0] -%}
      {%- assign padded_count = col.products_count | prepend: '00000' | slice: -5, 5 -%}
      {%- assign entry = padded_count | append: '::' | append: handle | append: '::' | append: cat -%}
      {%- assign sortable = sortable | append: entry | append: '||' -%}
    {%- endif -%}
  {%- endfor -%}

  {%- assign sorted_list = sortable | split: '||' | sort | reverse -%}

  <div class="ei-dg__grid">
    {%- for entry in sorted_list limit: section.settings.number_to_show -%}
      {%- assign parts = entry | split: '::' -%}
      {%- assign handle = parts[1] -%}
      {%- assign cat = parts[2] -%}
      {%- assign col = collections[handle] -%}
      <a href="{{ col.url }}" class="ei-dg__card">
        <div class="ei-dg__card-img">
          {% if col.image %}
            <img src="{{ col.image | img_url: '800x' }}" alt="{{ col.title | escape }}" loading="lazy" width="800" height="1067">
          {% else %}
            <div class="ei-dg__card-placeholder">
              <span class="ei-dg__card-initial">{{ col.title | slice: 0 }}</span>
            </div>
          {% endif %}
          <div class="ei-dg__card-badge">{{ col.products_count }} piece{% if col.products_count != 1 %}s{% endif %}</div>
        </div>
        <div class="ei-dg__card-info">
          <p class="ei-dg__card-cat">{{ cat }}</p>
          <p class="ei-dg__card-name ei-serif">{{ col.title }}</p>
          <p class="ei-dg__card-cta">Shop collection →</p>
        </div>
      </a>
    {%- endfor -%}
  </div>
</section>

<style>
.ei-dg__grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;box-sizing:border-box}
.ei-dg__card{display:block;width:100%;box-sizing:border-box;text-decoration:none;color:inherit;background:#fff;border-radius:2px;overflow:hidden;border:1px solid #E8E4DF;box-shadow:0 1px 4px rgba(13,27,62,.06);transition:all .2s ease}
.ei-dg__card:hover{box-shadow:0 4px 20px rgba(13,27,62,.12);transform:translateY(-2px);border-color:#E8E4DF}
.ei-dg__card:hover img{transform:scale(1.04)}
.ei-dg__card-img{position:relative;width:100%;aspect-ratio:3/4;overflow:hidden;background:#F5F3F0;box-sizing:border-box}
.ei-dg__card-img img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .5s ease}
.ei-dg__card-placeholder{width:100%;height:100%;background:#F0EDE8;display:flex;align-items:center;justify-content:center}
.ei-dg__card-initial{font-family:'Cormorant Garamond',Georgia,serif;font-size:56px;font-weight:300;font-style:italic;color:#D4CFC8}
.ei-dg__card-badge{position:absolute;bottom:10px;left:10px;font-size:9px;letter-spacing:.15em;text-transform:uppercase;color:#fff;background:rgba(13,27,62,.7);padding:3px 8px;border-radius:2px;backdrop-filter:blur(4px)}
.ei-dg__card-info{padding:14px 16px 16px;border-top:2px solid #0D1B3E;background:#fff;box-sizing:border-box}
.ei-dg__card-cat{font-size:9px;letter-spacing:.2em;text-transform:uppercase;color:#CFAE70;margin-bottom:4px;font-weight:500}
.ei-dg__card-name{font-family:'Cormorant Garamond',Georgia,serif;font-size:18px;font-style:italic;color:#0D1B3E;margin-bottom:6px;line-height:1.25}
.ei-dg__card-cta{font-size:10px;letter-spacing:.1em;color:#999;transition:color .2s ease}
.ei-dg__card:hover .ei-dg__card-cta{color:#0D1B3E}
@media(max-width:768px){.ei-dg__grid{grid-template-columns:repeat(2,1fr)}}
</style>

{% schema %}
{
  "name": "Designer Grid",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by Designer" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Every designer we carry is here for a reason." },
    { "type": "url", "id": "view_all_url", "label": "View all link" },
    { "type": "range", "id": "number_to_show", "label": "Designers to show", "min": 3, "max": 9, "step": 3, "default": 6 }
  ],
  "presets": [{ "name": "Designer Grid" }]
}
{% endschema %}
