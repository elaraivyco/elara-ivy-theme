<div class="ph">

  {{-- ═══════════════════════════════════════ --}}
  {{-- HERO --}}
  {{-- ═══════════════════════════════════════ --}}
  <div class="ph-hero">
    <div class="ph-hero__media">
      {%- if section.settings.hero_image -%}
        <img
          src="{{ section.settings.hero_image | img_url: '2000x' }}"
          alt="{{ section.settings.heading | escape }}"
          loading="eager"
          class="ph-hero__img"
        >
      {%- else -%}
        <div class="ph-hero__placeholder">
          <div class="ph-hero__placeholder-inner">
            <p class="ph-hero__placeholder-text">Add a hero image in the theme editor</p>
          </div>
        </div>
      {%- endif -%}
      <div class="ph-hero__overlay"></div>
    </div>
    <div class="ph-hero__content">
      <p class="ph-hero__eyebrow">{{ section.settings.eyebrow }}</p>
      <h1 class="ph-hero__heading">{{ section.settings.heading }}</h1>
      <p class="ph-hero__body">{{ section.settings.hero_body }}</p>
      <div class="ph-hero__rule"></div>
    </div>
    <div class="ph-hero__scroll">
      <span>Scroll</span>
      <div class="ph-hero__scroll-line"></div>
    </div>
  </div>

  {{-- ═══════════════════════════════════════ --}}
  {{-- OPENER / QUOTE --}}
  {{-- ═══════════════════════════════════════ --}}
  <div class="ph-opener">
    <div class="ph-opener__label">{{ section.settings.opener_label }}</div>
    <blockquote class="ph-opener__quote">{{ section.settings.quote }}</blockquote>
    <div class="ph-opener__rule"></div>
    <p class="ph-opener__body">{{ section.settings.opener_body }}</p>
  </div>

  {{-- ═══════════════════════════════════════ --}}
  {{-- PILLARS --}}
  {{-- ═══════════════════════════════════════ --}}
  <div class="ph-pillars">
    <div class="ph-pillars__header">
      <p class="ph-pillars__label">{{ section.settings.pillars_label }}</p>
      <h2 class="ph-pillars__heading">{{ section.settings.pillars_heading }}</h2>
    </div>
    <div class="ph-pillars__grid">
      {%- assign pillar_index = 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'pillar' -%}
          {%- assign pillar_index = pillar_index | plus: 1 -%}
          <div class="ph-pillar" {{ block.shopify_attributes }}>
            <div class="ph-pillar__num">
              {%- if pillar_index < 10 -%}0{%- endif -%}{{ pillar_index }}
            </div>
            <div class="ph-pillar__line"></div>
            <h3 class="ph-pillar__title">{{ block.settings.title }}</h3>
            <p class="ph-pillar__body">{{ block.settings.body }}</p>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

  {{-- ═══════════════════════════════════════ --}}
  {{-- INTERLUDE --}}
  {{-- ═══════════════════════════════════════ --}}
  <div class="ph-interlude">
    <div class="ph-interlude__inner">
      <p class="ph-interlude__label">{{ section.settings.interlude_label }}</p>
      <h2 class="ph-interlude__heading">{{ section.settings.interlude_heading }}</h2>
      <p class="ph-interlude__body">{{ section.settings.interlude_body }}</p>
    </div>
  </div>

  {{-- ═══════════════════════════════════════ --}}
  {{-- WHAT WE DON'T DO --}}
  {{-- ═══════════════════════════════════════ --}}
  <div class="ph-dontdo">
    <div class="ph-dontdo__inner">
      <div class="ph-dontdo__header">
        <p class="ph-dontdo__label">{{ section.settings.dontdo_label }}</p>
        <h2 class="ph-dontdo__heading">{{ section.settings.dontdo_heading }}</h2>
        <p class="ph-dontdo__intro">{{ section.settings.dontdo_intro }}</p>
      </div>
      <div class="ph-dontdo__list">
        {%- for block in section.blocks -%}
          {%- if block.type == 'dont_item' -%}
            <div class="ph-dont-item" {{ block.shopify_attributes }}>
              <div class="ph-dont-icon">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
                  <line x1="18" y1="6" x2="6" y2="18"/>
                  <line x1="6" y1="6" x2="18" y2="18"/>
                </svg>
              </div>
              <div class="ph-dont-content">
                <p class="ph-dont-title">{{ block.settings.title }}</p>
                <p class="ph-dont-body">{{ block.settings.body }}</p>
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>

  {{-- ═══════════════════════════════════════ --}}
  {{-- PROMISE + STATS --}}
  {{-- ═══════════════════════════════════════ --}}
  <div class="ph-promise">
    <div class="ph-promise__text">
      <p class="ph-promise__label">{{ section.settings.promise_label }}</p>
      <h2 class="ph-promise__heading">{{ section.settings.promise_heading }}</h2>
      <p class="ph-promise__body">{{ section.settings.promise_body }}</p>
    </div>
    <div class="ph-promise__stats">
      {%- for block in section.blocks -%}
        {%- if block.type == 'stat' -%}
          <div class="ph-stat" {{ block.shopify_attributes }}>
            <div class="ph-stat__num">{{ block.settings.number }}</div>
            <div class="ph-stat__label">{{ block.settings.label }}</div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

  {{-- ═══════════════════════════════════════ --}}
  {{-- CLOSING --}}
  {{-- ═══════════════════════════════════════ --}}
  <div class="ph-closing">
    <div class="ph-closing__inner">
      <div class="ph-closing__rule"></div>
      <h2 class="ph-closing__heading">{{ section.settings.closing_heading }}</h2>
      <p class="ph-closing__body">{{ section.settings.closing_body }}</p>
      <div class="ph-closing__ctas">
        {%- if section.settings.cta_primary_label != blank -%}
          <a href="{{ section.settings.cta_primary_url }}" class="ph-btn-primary">{{ section.settings.cta_primary_label }}</a>
        {%- endif -%}
        {%- if section.settings.cta_secondary_label != blank -%}
          <a href="{{ section.settings.cta_secondary_url }}" class="ph-btn-secondary">{{ section.settings.cta_secondary_label }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>

</div>

<style>
/* ─── GLOBAL ─────────────────────────────── */
.ph {
  font-family: 'Jost', sans-serif;
  color: #0D1B3E;
}

/* ─── HERO ───────────────────────────────── */
.ph-hero {
  position: relative;
  height: 92vh;
  min-height: 600px;
  max-height: 900px;
  display: flex;
  align-items: flex-end;
  overflow: hidden;
}

.ph-hero__media {
  position: absolute;
  inset: 0;
}

.ph-hero__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center 20%;
  display: block;
}

.ph-hero__placeholder {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #0D1B3E 0%, #1a2d5a 50%, #2a3f6f 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.ph-hero__placeholder-text {
  font-size: 11px;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.3);
}

.ph-hero__overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to top,
    rgba(13,27,62,0.85) 0%,
    rgba(13,27,62,0.4) 40%,
    rgba(13,27,62,0.1) 100%
  );
}

.ph-hero__content {
  position: relative;
  z-index: 2;
  padding: 0 80px 72px;
  max-width: 680px;
}

.ph-hero__eyebrow {
  font-size: 10px;
  letter-spacing: 0.4em;
  text-transform: uppercase;
  color: #CFAE70;
  margin-bottom: 20px;
}

.ph-hero__heading {
  font-family: 'Cormorant Garamond', Georgia, serif;
  font-size: clamp(40px, 5.5vw, 68px);
  font-weight: 300;
  font-style: italic;
  color: #ffffff;
  line-height: 1.1;
  margin-bottom: 20px;
}

.ph-hero__body {
  font-size: 15px;
  font-weight: 300;
  color: rgba(255,255,255,0.65);
  line-height: 1.8;
  max-width: 440px;
  margin-bottom: 28px;
}

.ph-hero__rule {
  width: 48px;
  height: 1px;
  background: #CFAE70;
}

.ph-hero__scroll {
  position: absolute;
  right: 48px;
  bottom: 72px;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
}

.ph-hero__scroll span {
  font-size: 9px;
  letter-spacing: 0.25em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.4);
  writing-mode: vertical-rl;
}

.ph-hero__scroll-line {
  width: 1px;
  height: 48px;
  background: linear-gradient(to bottom, rgba(255,255,255,0.3), rgba(255,255,255,0));
}

/* ─── OPENER ─────────────────────────────── */
.ph-opener {
  padding: 96px 80px;
  max-width: 800px;
  margin: 0 auto;
  text-align: center;
}

.ph-opener__label {
  font-size: 9px;
  letter-spacing: 0.35em;
  text-transform: uppercase;
  color: #CFAE70;
  margin-bottom: 40px;
}

.ph-opener__quote {
  font-family: 'Cormorant Garamond', Georgia, serif;
  font-size: clamp(32px, 4vw, 52px);
  font-weight: 300;
  font-style: italic;
  color: #0D1B3E;
  line-height: 1.2;
  margin: 0 0 40px;
  quotes: none;
}

.ph-opener__rule {
  width: 1px;
  height: 64px;
  background: linear-gradient(to bottom, #CFAE70, rgba(207,174,112,0));
  margin: 0 auto 40px;
}

.ph-opener__body {
  font-size: 16px;
  font-weight: 300;
  line-height: 1.9;
  color: #555;
  max-width: 580px;
  margin: 0 auto;
}

/* ─── PILLARS ────────────────────────────── */
.ph-pillars {
  background: #F5F3F0;
  padding: 96px 80px;
}

.ph-pillars__header {
  margin-bottom: 64px;
}

.ph-pillars__label {
  font-size: 9px;
  letter-spacing: 0.35em;
  text-transform: uppercase;
  color: #6E73B8;
  margin-bottom: 16px;
}

.ph-pillars__heading {
  font-family: 'Cormorant Garamond', Georgia, serif;
  font-size: clamp(28px, 3.5vw, 44px);
  font-weight: 300;
  font-style: italic;
  color: #0D1B3E;
  max-width: 480px;
}

.ph-pillars__grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 48px;
}

.ph-pillar {
  padding-top: 8px;
}

.ph-pillar__num {
  font-family: 'Cormorant Garamond', Georgia, serif;
  font-size: 48px;
  font-weight: 300;
  font-style: italic;
  color: rgba(13,27,62,0.1);
  line-height: 1;
  margin-bottom: 16px;
}

.ph-pillar__line {
  width: 32px;
  height: 1px;
  background: #CFAE70;
  margin-bottom: 20px;
}

.ph-pillar__title {
  font-family: 'Cormorant Garamond', Georgia, serif;
  font-size: 22px;
  font-weight: 400;
  font-style: italic;
  color: #0D1B3E;
  margin-bottom: 12px;
  line-height: 1.3;
}

.ph-pillar__body {
  font-size: 14px;
  font-weight: 300;
  line-height: 1.85;
  color: #666;
}

/* ─── INTERLUDE ──────────────────────────── */
.ph-interlude {
  background: #0D1B3E;
  padding: 96px 80px;
  background-image:
    radial-gradient(ellipse at 90% 10%, rgba(207,174,112,0.08) 0%, transparent 50%),
    radial-gradient(ellipse at 10% 90%, rgba(110,115,184,0.08) 0%, transparent 50%);
}

.ph-interlude__inner {
  max-width: 640px;
  margin: 0 auto;
  text-align: center;
}

.ph-interlude__label {
  font-size: 9px;
  letter-spacing: 0.35em;
  text-transform: uppercase;
  color: rgba(207,174,112,0.7);
  margin-bottom: 24px;
}

.ph-interlude__heading {
  font-family: 'Cormorant Garamond', Georgia, serif;
  font-size: clamp(32px, 4vw, 52px);
  font-weight: 300;
  font-style: italic;
  color: #ffffff;
  line-height: 1.15;
  margin-bottom: 24px;
}

.ph-interlude__body {
  font-size: 15px;
  font-weight: 300;
  line-height: 1.9;
  color: rgba(255,255,255,0.5);
}

/* ─── WHAT WE DON'T DO ───────────────────── */
.ph-dontdo {
  padding: 96px 80px;
  background: #ffffff;
}

.ph-dontdo__inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 80px;
  align-items: start;
}

.ph-dontdo__label {
  font-size: 9px;
  letter-spacing: 0.35em;
  text-transform: uppercase;
  color: #CFAE70;
  margin-bottom: 16px;
}

.ph-dontdo__heading {
  font-family: 'Cormorant Garamond', Georgia, serif;
  font-size: clamp(28px, 3.5vw, 44px);
  font-weight: 300;
  font-style: italic;
  color: #0D1B3E;
  margin-bottom: 16px;
  line-height: 1.2;
}

.ph-dontdo__intro {
  font-size: 14px;
  font-weight: 300;
  line-height: 1.85;
  color: #666;
}

.ph-dontdo__list {
  display: flex;
  flex-direction: column;
  gap: 32px;
  padding-top: 8px;
}

.ph-dont-item {
  display: flex;
  gap: 20px;
  align-items: flex-start;
  padding-bottom: 32px;
  border-bottom: 1px solid #F0EDE8;
}

.ph-dont-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.ph-dont-icon {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  border: 1px solid #E8E4DF;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  color: #CFAE70;
  margin-top: 2px;
}

.ph-dont-title {
  font-family: 'Cormorant Garamond', Georgia, serif;
  font-size: 18px;
  font-style: italic;
  color: #0D1B3E;
  margin-bottom: 6px;
}

.ph-dont-body {
  font-size: 13px;
  font-weight: 300;
  line-height: 1.8;
  color: #888;
}

/* ─── PROMISE ────────────────────────────── */
.ph-promise {
  background: #F5F3F0;
  padding: 96px 80px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 80px;
  align-items: center;
}

.ph-promise__label {
  font-size: 9px;
  letter-spacing: 0.35em;
  text-transform: uppercase;
  color: #CFAE70;
  margin-bottom: 16px;
}

.ph-promise__heading {
  font-family: 'Cormorant Garamond', Georgia, serif;
  font-size: clamp(28px, 3.5vw, 44px);
  font-weight: 300;
  font-style: italic;
  color: #0D1B3E;
  margin-bottom: 20px;
  line-height: 1.2;
}

.ph-promise__body {
  font-size: 15px;
  font-weight: 300;
  line-height: 1.9;
  color: #666;
}

.ph-promise__stats {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 40px;
}

.ph-stat {
  padding: 32px;
  background: #ffffff;
  border-top: 2px solid #CFAE70;
}

.ph-stat__num {
  font-family: 'Cormorant Garamond', Georgia, serif;
  font-size: 48px;
  font-weight: 300;
  font-style: italic;
  color: #0D1B3E;
  line-height: 1;
  margin-bottom: 8px;
}

.ph-stat__label {
  font-size: 11px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: #999;
  line-height: 1.4;
}

/* ─── CLOSING ────────────────────────────── */
.ph-closing {
  background: #0D1B3E;
  padding: 120px 80px;
  background-image:
    radial-gradient(ellipse at 80% 50%, rgba(207,174,112,0.06) 0%, transparent 55%);
}

.ph-closing__inner {
  max-width: 560px;
  margin: 0 auto;
  text-align: center;
}

.ph-closing__rule {
  width: 1px;
  height: 64px;
  background: linear-gradient(to bottom, rgba(207,174,112,0.6), rgba(207,174,112,0));
  margin: 0 auto 48px;
}

.ph-closing__heading {
  font-family: 'Cormorant Garamond', Georgia, serif;
  font-size: clamp(32px, 4vw, 52px);
  font-weight: 300;
  font-style: italic;
  color: #ffffff;
  margin-bottom: 20px;
  line-height: 1.15;
}

.ph-closing__body {
  font-size: 15px;
  font-weight: 300;
  line-height: 1.85;
  color: rgba(255,255,255,0.5);
  margin-bottom: 40px;
}

.ph-closing__ctas {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16px;
  flex-wrap: wrap;
}

.ph-btn-primary {
  font-family: 'Jost', sans-serif;
  font-size: 11px;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  padding: 14px 32px;
  background: #CFAE70;
  color: #0D1B3E;
  text-decoration: none;
  border: 1px solid #CFAE70;
  transition: all 0.2s ease;
  display: inline-block;
}

.ph-btn-primary:hover {
  background: transparent;
  color: #CFAE70;
}

.ph-btn-secondary {
  font-family: 'Jost', sans-serif;
  font-size: 11px;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  padding: 14px 32px;
  background: transparent;
  color: rgba(255,255,255,0.7);
  text-decoration: none;
  border: 1px solid rgba(255,255,255,0.2);
  transition: all 0.2s ease;
  display: inline-block;
}

.ph-btn-secondary:hover {
  border-color: rgba(255,255,255,0.6);
  color: #ffffff;
}

/* ─── RESPONSIVE ─────────────────────────── */
@media (max-width: 1024px) {
  .ph-pillars__grid { grid-template-columns: repeat(2, 1fr); }
  .ph-dontdo__inner { grid-template-columns: 1fr; gap: 48px; }
  .ph-promise { grid-template-columns: 1fr; gap: 48px; }
}

@media (max-width: 768px) {
  .ph-hero__content { padding: 0 32px 56px; }
  .ph-hero__scroll { display: none; }
  .ph-opener { padding: 64px 32px; }
  .ph-pillars { padding: 64px 32px; }
  .ph-pillars__grid { grid-template-columns: 1fr; gap: 40px; }
  .ph-interlude { padding: 64px 32px; }
  .ph-dontdo { padding: 64px 32px; }
  .ph-promise { padding: 64px 32px; }
  .ph-promise__stats { grid-template-columns: 1fr; }
  .ph-closing { padding: 80px 32px; }
}
</style>

{% schema %}
{
  "name": "Our Philosophy",
  "settings": [
    { "type": "image_picker", "id": "hero_image", "label": "Hero image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "THE ELARA IVY EDIT" },
    { "type": "textarea", "id": "heading", "label": "Hero heading", "default": "We don't carry everything. Deliberately." },
    { "type": "textarea", "id": "hero_body", "label": "Hero body", "default": "A note on how we choose what earns a place in our edit — and why most things don't make it." },
    { "type": "text", "id": "opener_label", "label": "Opener label", "default": "OUR CURATION PHILOSOPHY" },
    { "type": "textarea", "id": "quote", "label": "Pull quote", "default": "The most powerful word in fashion is no." },
    { "type": "textarea", "id": "opener_body", "label": "Opener body", "default": "At Elara Ivy Co., we believe a smaller edit is a more honest one. Every label we carry has earned its place through a process that is equal parts rigorous and instinctive — guided by craft, story, and the kind of longevity that outlasts any single season." },
    { "type": "text", "id": "pillars_label", "label": "Pillars label", "default": "HOW WE CHOOSE" },
    { "type": "text", "id": "pillars_heading", "label": "Pillars heading", "default": "Three questions. Every single time." },
    { "type": "text", "id": "interlude_label", "label": "Interlude label", "default": "A NOTE ON NEWNESS" },
    { "type": "text", "id": "interlude_heading", "label": "Interlude heading", "default": "We add slowly. We remove rarely." },
    { "type": "textarea", "id": "interlude_body", "label": "Interlude body", "default": "Our designer roster grows by invitation, not application. When a new house joins the Elara Ivy edit, it means something — to us, and to you. We don't chase trends. We look for permanence." },
    { "type": "text", "id": "dontdo_label", "label": "What we don't do label", "default": "WHAT SETS US APART" },
    { "type": "text", "id": "dontdo_heading", "label": "What we don't do heading", "default": "A few things you won't find here." },
    { "type": "textarea", "id": "dontdo_intro", "label": "What we don't do intro", "default": "We think the clearest way to explain what we stand for is to explain what we don't do. These aren't policies — they're the natural result of caring deeply about what we sell and who we sell it to." },
    { "type": "text", "id": "promise_label", "label": "Promise label", "default": "OUR COMMITMENT" },
    { "type": "text", "id": "promise_heading", "label": "Promise heading", "default": "To every designer we carry." },
    { "type": "textarea", "id": "promise_body", "label": "Promise body", "default": "When we bring a designer into the Elara Ivy edit, we commit to telling their story honestly, presenting their work beautifully, and championing them to our community with the same enthusiasm we'd want for our own." },
    { "type": "text", "id": "closing_heading", "label": "Closing heading", "default": "Ready to meet the edit?" },
    { "type": "textarea", "id": "closing_body", "label": "Closing body", "default": "Every piece in the Elara Ivy Co. collection has earned its place. We think you'll feel the difference the moment you find it." },
    { "type": "text", "id": "cta_primary_label", "label": "Primary CTA", "default": "EXPLORE THE EDIT" },
