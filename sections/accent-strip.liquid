<div class="accent-strip">
  <div>
    {% if section.settings.label != blank %}
      <div class="accent-strip__label">{{ section.settings.label }}</div>
    {% endif %}
    <div class="accent-strip__heading ei-serif">{{ section.settings.heading }}</div>
    {% if section.settings.body != blank %}
      <p class="accent-strip__body">{{ section.settings.body }}</p>
    {% endif %}
  </div>
  {% if section.settings.cta_label != blank %}
    <a href="{{ section.settings.cta_url }}" class="accent-strip__cta">{{ section.settings.cta_label }}</a>
  {% endif %}
</div>

{% schema %}
{
  "name": "Accent Strip",
  "settings": [
    { "type": "text", "id": "label", "label": "Eyebrow label", "default": "THE ELARA IVY EDIT" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Not everything makes the cut. That's the point." },
    { "type": "textarea", "id": "body", "label": "Body text", "default": "We spend months vetting new designers so you don't have to." },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "READ OUR PHILOSOPHY" },
    { "type": "url", "id": "cta_url", "label": "CTA link" }
  ],
  "presets": [{ "name": "Accent Strip" }]
}
{% endschema %}
