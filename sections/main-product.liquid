{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign featured_image = current_variant.featured_image | default: product.featured_image -%}

<div class="breadcrumb">
  <a href="{{ routes.root_url }}">Home</a> ›
  {% if product.collections.first %}
    <a href="{{ product.collections.first.url }}">{{ product.collections.first.title }}</a> ›
  {% endif %}
  <span class="current">{{ product.title }}</span>
</div>

<div class="pdp-layout">
  <div class="pdp-gallery">
    <div class="pdp-gallery__main">
      <div class="pdp-gallery__badge">
        <div class="pdp-gallery__badge-label">DESIGNER</div>
        <div class="pdp-gallery__badge-name ei-serif">{{ product.vendor }}</div>
      </div>
      {% if featured_image %}
        <img id="pdp-main-img"
          src="{{ featured_image | img_url: '1000x' }}"
          alt="{{ featured_image.alt | escape }}"
          loading="eager">
      {% endif %}
    </div>
    {% if product.images.size > 1 %}
      <div class="pdp-gallery__thumbs">
        {% for image in product.images limit: 4 %}
          <div class="pdp-gallery__thumb {% if forloop.first %}is-active{% endif %}"
               data-src="{{ image | img_url: '1000x' }}">
            <img src="{{ image | img_url: '200x' }}" alt="{{ image.alt | escape }}">
          </div>
        {% endfor %}
      </div>
    {% endif %}
  </div>

  <div class="pdp-info">
    <div class="pdp-info__designer-tag">{{ product.vendor | upcase }}</div>
    <h1 class="pdp-info__title ei-serif">{{ product.title }}</h1>
    {% if product.metafields.custom.subtitle %}
      <div class="pdp-info__sub">{{ product.metafields.custom.subtitle }}</div>
    {% endif %}
    <div class="pdp-info__price">{{ current_variant.price | money }}</div>
    <div class="pdp-info__price-note">TAX INCLUDED · RETURNS ACCEPTED WITHIN 14 DAYS</div>
    <div class="pdp-info__rule"></div>

    <form action="{{ routes.cart_add_url }}" method="post" id="product-form">
      <input type="hidden" name="id" value="{{ current_variant.id }}">

      {% unless product.has_only_default_variant %}
        {% for option in product.options_with_values %}
          <div class="option-label">{{ option.name | upcase }}
            {% if option.name == 'Color' or option.name == 'Colour' %}
              — <strong>{{ option.selected_value }}</strong>
            {% endif %}
          </div>
          {% if option.name == 'Color' or option.name == 'Colour' %}
            <div class="colour-row">
              {% for value in option.values %}
                <div class="colour-swatch {% if option.selected_value == value %}is-active{% endif %}"
                     title="{{ value }}"
                     style="background:{{ value | handleize }};">
                </div>
              {% endfor %}
            </div>
          {% else %}
            <div class="size-row">
              {% for value in option.values %}
                <button type="button"
                  class="size-btn {% if option.selected_value == value %}is-active{% endif %}">
                  {{ value }}
                </button>
              {% endfor %}
            </div>
          {% endif %}
        {% endfor %}
      {% endunless %}

      <button type="submit" class="btn-add-to-cart"
        {% unless current_variant.available %}disabled{% endunless %}>
        {% if current_variant.available %}ADD TO BAG{% else %}SOLD OUT{% endif %}
      </button>
    </form>

    <button class="btn-wishlist">
      <svg viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
      SAVE TO WISHLIST
    </button>

    <div class="pdp-highlights">
      <div class="pdp-highlights__row">
        <svg viewBox="0 0 24 24"><rect x="1" y="3" width="15" height="13" rx="1"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
        <span>Complimentary express shipping on orders over £200</span>
      </div>
      <div class="pdp-highlights__row">
        <svg viewBox="0 0 24 24"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
        <span>Returns accepted within 14 days of delivery — <a href="/pages/returns" style="color:inherit;text-decoration:underline;">view full policy</a></span>
      </div>
      <div class="pdp-highlights__row">
        <svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        <span>Authentic luxury — every piece verified</span>
      </div>
    </div>

    {% if product.description != blank %}
      <div class="pdp-info__rule"></div>
      <div class="pdp-description">
        {{ product.description }}
      </div>
    {% endif %}

  </div>
</div>

{% schema %}
{
  "name": "Product",
  "settings": [],
  "presets": [{ "name": "Product" }]
}
{% endschema %}

