<div class="editorial-strip">
  <div>
    {% if section.settings.label != blank %}
      <div class="editorial-strip__label">{{ section.settings.label }}</div>
    {% endif %}
    <h2 class="editorial-strip__heading ei-serif">{{ section.settings.heading }}</h2>
    {% if section.settings.body != blank %}
      <p class="editorial-strip__body">{{ section.settings.body }}</p>
    {% endif %}
    {% if section.settings.link_label != blank %}
      <a href="{{ section.settings.link_url }}" class="editorial-strip__link">{{ section.settings.link_label }}</a>
    {% endif %}
  </div>
  <div class="editorial-strip__img">
    {% if section.settings.image %}
      <img src="{{ section.settings.image | img_url: '800x' }}" alt="{{ section.settings.heading | escape }}" loading="lazy">
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Editorial Strip",
  "settings": [
    { "type": "text", "id": "label", "label": "Eyebrow label", "default": "FROM THE JOURNAL" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Summer dressing, done with intention." },
    { "type": "textarea", "id": "body", "label": "Body text", "default": "Our SS26 edit is built around ease — pieces that move between beach and dinner." },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "READ THE STORY" },
    { "type": "url", "id": "link_url", "label": "Link URL" },
    { "type": "image_picker", "id": "image", "label": "Editorial image" }
  ],
  "presets": [{ "name": "Editorial Strip" }]
}
{% endschema %}
