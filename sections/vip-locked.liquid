{% comment %} sections/vip-locked.liquid {% endcomment %}

<div style="background:var(--navy);min-height:80vh;display:flex;align-items:center;justify-content:center;padding:48px 24px;text-align:center;position:relative;overflow:hidden;">
  <div style="position:absolute;top:-80px;right:-80px;width:400px;height:400px;border-radius:50%;background:var(--periwinkle);opacity:0.05;"></div>
  <div style="position:absolute;bottom:-100px;left:-60px;width:360px;height:360px;border-radius:50%;background:var(--blush);opacity:0.04;"></div>
  <div style="max-width:480px;position:relative;">
    <div style="width:48px;height:48px;border:1.5px solid rgba(255,255,255,0.15);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 24px;">
      <svg viewBox="0 0 24 24" style="width:20px;height:20px;stroke:var(--periwinkle);fill:none;stroke-width:1.5;">
        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
      </svg>
    </div>
    <div style="font-size:9px;letter-spacing:0.32em;color:var(--periwinkle);margin-bottom:16px;">MEMBERS ONLY</div>
    <h1 class="ei-serif" style="font-size:42px;line-height:1.06;color:#fff;font-weight:300;font-style:italic;margin-bottom:16px;">This space is<br>by invitation only.</h1>
    <p style="font-size:13px;color:rgba(255,255,255,0.45);line-height:1.85;margin-bottom:36px;">The Elara Ivy Inner Circle is a private membership for our most discerning clients — early access, exclusive pricing, and members-only edits.</p>
    <div style="display:flex;flex-direction:column;gap:10px;align-items:center;">
      {% if customer %}
        <p style="font-size:12px;color:rgba(255,255,255,0.35);margin-bottom:8px;">You're logged in but don't have Inner Circle access yet.</p>
        <a href="/pages/inner-circle-apply" class="btn-primary">APPLY FOR MEMBERSHIP</a>
      {% else %}
        <a href="/pages/inner-circle-apply" class="btn-primary">APPLY FOR MEMBERSHIP</a>
        <a href="{{ routes.account_login_url }}?return_url=/pages/inner-circle" style="font-size:10px;letter-spacing:0.16em;color:rgba(255,255,255,0.4);border-bottom:1px solid rgba(255,255,255,0.2);padding-bottom:1px;">ALREADY A MEMBER? SIGN IN</a>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "VIP Locked Page",
  "settings": [],
  "presets": [{ "name": "VIP Locked" }]
}
{% endschema %}
