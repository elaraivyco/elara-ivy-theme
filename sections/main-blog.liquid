<div class="section section--white">
  <div class="section__header">
    <h1 class="section__title ei-serif">{{ blog.title }}</h1>
  </div>
  <div class="product-grid" style="margin-top:32px;">
    {% for article in blog.articles %}
      <div class="product-card">
        <a href="{{ article.url }}">
          {% if article.image %}
            <div class="product-card__media">
              <img src="{{ article.image | img_url: '600x' }}" alt="{{ article.image.alt | escape }}" loading="lazy">
            </div>
          {% endif %}
          <div class="product-card__info">
            <div class="product-card__designer">{{ article.published_at | date: '%B %d, %Y' }}</div>
            <div class="product-card__title ei-serif">{{ article.title }}</div>
            <div class="product-card__price" style="font-size:11px;">{{ article.excerpt | strip_html | truncate: 80 }}</div>
          </div>
        </a>
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Blog",
  "settings": [],
  "presets": [{ "name": "Blog" }]
}
{% endschema %}
