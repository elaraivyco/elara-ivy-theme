<div class="section section--white" style="max-width:720px;">
  <h1 class="section__title ei-serif" style="margin-bottom:8px;">Privacy Policy</h1>
  <p style="font-size:11px;color:var(--ink-muted);letter-spacing:0.06em;margin-bottom:40px;">YOUR DATA, YOUR CHOICE</p>
  <div style="font-size:13px;line-height:1.9;color:var(--ink-body);">
    {{ page.content }}
  </div>
  <div style="margin-top:48px;padding-top:32px;border-top:1px solid var(--rule);">
    {% form 'customer_privacy', id: 'privacy-form' %}
      <h2 class="ei-serif" style="font-size:24px;font-style:italic;font-weight:300;color:var(--navy);margin-bottom:12px;">Opt Out of Data Sharing</h2>
      <p style="font-size:12px;color:var(--ink-muted);line-height:1.8;margin-bottom:24px;">You have the right to opt out of the sharing of your personal information for targeted advertising purposes.</p>
      <label style="display:flex;align-items:flex-start;gap:12px;margin-bottom:24px;cursor:pointer;">
        <input type="checkbox" name="customer_privacy[opt_out]" style="margin-top:3px;accent-color:var(--navy);">
        <span style="font-size:12px;color:var(--ink-body);line-height:1.6;">Don't share data from my account (optional)</span>
      </label>
      <button type="submit" class="btn-primary">OPT OUT</button>
    {% endform %}
  </div>
</div>

{% schema %}
{
  "name": "Privacy Page",
  "settings": [],
  "presets": [{ "name": "Privacy" }]
}
{% endschema %}
