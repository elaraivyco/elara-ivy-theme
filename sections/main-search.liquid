<div class="section section--white">
  <h1 class="section__title ei-serif" style="margin-bottom:24px;">Search</h1>
  <form action="{{ routes.search_url }}" method="get" style="display:flex;gap:10px;margin-bottom:40px;">
    <input type="text" name="q" value="{{ search.terms | escape }}" placeholder="Search products, designers..."
      style="flex:1;border:1px solid var(--rule);padding:12px 16px;font-size:13px;font-family:var(--font-body);outline:none;">
    <button type="submit" class="btn-primary">SEARCH</button>
  </form>
  {% if search.performed %}
    {% if search.results_count == 0 %}
      <p style="color:var(--ink-muted);">No results for "{{ search.terms }}".</p>
    {% else %}
      <p style="font-size:11px;color:var(--ink-muted);margin-bottom:24px;">{{ search.results_count }} results for "{{ search.terms }}"</p>
      <div class="product-grid">
        {% for item in search.results %}
          <div class="product-card">
            <a href="{{ item.url }}">
              {% if item.featured_image %}
                <div class="product-card__media">
                  <img src="{{ item.featured_image | img_url: '400x' }}" alt="{{ item.title }}" loading="lazy">
                </div>
              {% endif %}
              <div class="product-card__info">
                <div class="product-card__title ei-serif">{{ item.title }}</div>
                {% if item.price %}<div class="product-card__price">{{ item.price | money }}</div>{% endif %}
              </div>
            </a>
          </div>
        {% endfor %}
      </div>
    {% endif %}
  {% endif %}
</div>

{% schema %}
{
  "name": "Search",
  "settings": [],
  "presets": [{ "name": "Search" }]
}
{% endschema %}
